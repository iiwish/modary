package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"net"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.ModulePath}}/internal/app"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	if err := run(ctx); err != nil {
		log.Fatal(err)
	}
}

func run(ctx context.Context) error {
	application, err := app.Start(ctx)
	if err != nil {
		return fmt.Errorf("start application: %w", err)
	}
	address := os.Getenv("MODARY_HTTP_ADDR")
	if address == "" {
		address = "127.0.0.1:8080"
	}
	server := &http.Server{
		Handler:           application.Handler(),
		ReadHeaderTimeout: 5 * time.Second,
		IdleTimeout:       60 * time.Second,
	}
	listener, err := net.Listen("tcp", address)
	if err != nil {
		return errors.Join(fmt.Errorf("listen on %s: %w", address, err), stopApplication(application))
	}
	serverResult := make(chan error, 1)
	go func() { serverResult <- server.Serve(listener) }()
	log.Printf("listening on http://%s", listener.Addr())

	select {
	case serveErr := <-serverResult:
		shutdownErr := stopApplication(application)
		if errors.Is(serveErr, http.ErrServerClosed) {
			serveErr = nil
		}
		return errors.Join(serveErr, shutdownErr)
	case <-ctx.Done():
		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		serverErr := server.Shutdown(shutdownCtx)
		applicationErr := application.Shutdown(shutdownCtx)
		return errors.Join(serverErr, applicationErr)
	}
}

func stopApplication(application *app.Application) error {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	return application.Shutdown(ctx)
}
