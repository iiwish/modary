// Package ping owns the starter application's example feature and HTTP route.
package ping

import (
	"context"
	"net/http"

	"github.com/iiwish/modary/appkit"
	"github.com/iiwish/modary/httpkit"
	"github.com/iiwish/modary/module"
)

// Registration declares the feature in the application's explicit Module graph.
func Registration() module.Registration {
	return module.Register(module.Manifest{
		SchemaVersion: module.SchemaVersion,
		ID:            "ping",
		Version:       "1.0.0",
		Type:          module.ModuleTypeFeature,
		Provides:      []module.Capability{"ping"},
	}, func(context.Context, module.Scope) error { return nil })
}

// Contribution declares the feature route before application startup.
func Contribution() httpkit.Contribution {
	return httpkit.Contribution{
		ID: "ping-http",
		Requires: []module.Capability{"ping"},
		Routes: []httpkit.RouteSpec{ {Method: http.MethodGet, Path: "/api/ping"} },
		Build: func(context.Context, *appkit.Application) ([]httpkit.Route, error) {
			return []httpkit.Route{ {
				Method: http.MethodGet,
				Path:   "/api/ping",
				Handler: http.HandlerFunc(func(writer http.ResponseWriter, _ *http.Request) {
					writer.Header().Set("Content-Type", "application/json")
					writer.WriteHeader(http.StatusOK)
					_, _ = writer.Write([]byte(`{"message":"pong"}`))
				}),
			} }, nil
		},
	}
}
