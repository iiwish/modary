	"{{.ModulePath}}/internal/adminapi"
	{{if .HasAudit}}"{{.ModulePath}}/internal/auditlog"
	{{end}}"{{.ModulePath}}/internal/config"
	"{{.ModulePath}}/internal/records"
	{{if .HasTasks}}"{{.ModulePath}}/internal/tasks"
	{{end}}"{{.ModulePath}}/internal/web"
	"github.com/iiwish/modary/appkit"
	"github.com/iiwish/modary/authz"
	{{if .HasOIDC}}"github.com/iiwish/modary/components/oidc"
