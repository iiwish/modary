name: {{.ID}}
services:
  database:
    image: postgres:17.10-alpine
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U app -d app"]
      interval: 2s
      timeout: 3s
      retries: 30
    volumes:
      - database-data:/var/lib/postgresql/data
    restart: unless-stopped

  migrate:
    build:
      context: .
    command: ["migrate"]
    depends_on:
      database:
        condition: service_healthy
    environment: &database-environment
      DATABASE_URL: postgres://app:${POSTGRES_PASSWORD}@database:5432/app?sslmode=disable
      MODARY_DATABASE_SCHEMA: {{.SchemaID}}
      {{if .HasTasks}}MODARY_QUEUE_SCHEMA: {{.QueueSchemaID}}
      {{end}}
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    restart: "no"

  application:
    build:
      context: .
    command: ["serve"]
    depends_on:
      database:
        condition: service_healthy
      migrate:
        condition: service_completed_successfully
    environment:
      <<: *database-environment
      {{if .HasOIDC}}MODARY_OIDC_ISSUER_URL: ${MODARY_OIDC_ISSUER_URL:?set MODARY_OIDC_ISSUER_URL}
      MODARY_OIDC_CLIENT_ID: ${MODARY_OIDC_CLIENT_ID:?set MODARY_OIDC_CLIENT_ID}
      MODARY_OIDC_CLIENT_SECRET: ${MODARY_OIDC_CLIENT_SECRET:-}
      MODARY_OIDC_REDIRECT_URL: ${MODARY_OIDC_REDIRECT_URL:?set MODARY_OIDC_REDIRECT_URL}
      MODARY_OIDC_SUBJECT: ${MODARY_OIDC_SUBJECT:?set MODARY_OIDC_SUBJECT}
      {{else}}MODARY_ADMIN_USERNAME: ${MODARY_ADMIN_USERNAME:-admin}
      MODARY_ADMIN_PASSWORD: ${MODARY_ADMIN_PASSWORD:?set MODARY_ADMIN_PASSWORD}
      {{end}}
      {{if .HasOTel}}MODARY_OTEL_ENDPOINT: ${MODARY_OTEL_ENDPOINT:?set MODARY_OTEL_ENDPOINT}
      MODARY_OTEL_ENVIRONMENT: ${MODARY_OTEL_ENVIRONMENT:-development}
      MODARY_OTEL_HEADERS_JSON: ${MODARY_OTEL_HEADERS_JSON:-}
      MODARY_OTEL_INSECURE: ${MODARY_OTEL_INSECURE:-false}
      {{end}}
      MODARY_HTTP_ADDR: 0.0.0.0:8080
    ports:
      - "${MODARY_HTTP_PORT:-8080}:8080"
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    init: true
    restart: unless-stopped

volumes:
  database-data:
