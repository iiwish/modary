func expectRecordPermissionDenials(t *testing.T, store database.Store, client *profileClient, record profileRecord) {
	t.Helper()
	tests := []struct {
		permission string
		method     string
		path       string
		body       any
		csrf       bool
	}{
		{permission: "records.list", method: http.MethodGet, path: "/api/records"},
		{permission: "records.create", method: http.MethodPost, path: "/api/records", body: map[string]any{"title": "Forbidden create", "status": "draft"}, csrf: true},
		{permission: "records.update", method: http.MethodPatch, path: "/api/records/" + record.ID, body: map[string]any{"title": "Forbidden update", "status": "active", "version": record.Version}, csrf: true},
		{permission: "records.delete", method: http.MethodDelete, path: "/api/records/" + record.ID, body: map[string]any{}, csrf: true},
	}
	for _, test := range tests {
		setPermission(t, store, test.permission, false)
		client.expectAdminContext(expectedAdminDescriptors(), adminGrantsWithout(test.permission))
		response := client.request(test.method, test.path, test.body, test.csrf)
		setPermission(t, store, test.permission, true)
		if response.Code != http.StatusForbidden {
			t.Fatalf("forbidden %s %s with %s=%d %s", test.method, test.path, test.permission, response.Code, response.Body.String())
		}
	}
	client.expectAdminContext(expectedAdminDescriptors(), expectedAdminGrants())
	client.expectList(record.ID, record.Title)
}

type expectedAdminDescriptor struct {
	ID                  string   `json:"id"`
	Label               string   `json:"label"`
	Path                string   `json:"path"`
	Icon                string   `json:"icon"`
	Order               int      `json:"order"`
	Permissions         []string `json:"permissions"`
	RequiredPermissions []string `json:"requiredPermissions"`
}

func expectedAdminDescriptors() []expectedAdminDescriptor {
	return []expectedAdminDescriptor{
		{ID: "records", Label: "记录", Path: "/records", Icon: "database", Order: 100,
			Permissions: []string{"records.create", "records.delete", "records.list", "records.update"}, RequiredPermissions: []string{"records.list"}},
		{{if .HasTasks}}{ID: "tasks", Label: "任务", Path: "/tasks", Icon: "list-todo", Order: 200,
			Permissions: []string{"tasks.read"}, RequiredPermissions: []string{"tasks.read"}},
		{{end}}{{if .HasAudit}}{ID: "audit", Label: "审计日志", Path: "/audit", Icon: "history", Order: 300,
			Permissions: []string{"audit.read"}, RequiredPermissions: []string{"audit.read"}},
		{{end}}
	}
}

func expectedAdminGrants() []string {
	return []string{
		{{if .HasAudit}}"audit.read",
		{{end}}"records.create", "records.delete", "records.list", "records.update"{{if .HasTasks}}, "tasks.read"{{end}},
	}
}

func adminGrantsWithout(excluded string) []string {
	grants := expectedAdminGrants()
	result := make([]string, 0, len(grants)-1)
	for _, grant := range grants {
		if grant != excluded { result = append(result, grant) }
	}
	return result
}

type profileRecord struct {
	ID        string    `json:"id"`
	Title     string    `json:"title"`
	Status    string    `json:"status"`
	Version   int64     `json:"version"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

type profileClient struct {
	t *testing.T
	handler http.Handler
	cookie *http.Cookie
	csrf string
}

func newProfileClient(t *testing.T, handler http.Handler) *profileClient {
	return &profileClient{t: t, handler: handler}
}

func (client *profileClient) health() {
	response := client.request(http.MethodGet, "/healthz", nil, false)
	if response.Code != http.StatusOK {
		client.t.Fatalf("health=%d %s", response.Code, response.Body.String())
	}
}

func (client *profileClient) web() {
	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.Header.Set("Accept", "text/html")
	response := httptest.NewRecorder()
	client.handler.ServeHTTP(response, request)
	if response.Code != http.StatusOK || !bytes.Contains(response.Body.Bytes(), []byte(`<div id="root"></div>`)) {
		client.t.Fatalf("web index=%d %s", response.Code, response.Body.String())
	}
	match := adminScriptPattern.FindSubmatch(response.Body.Bytes())
	if len(match) != 2 {
		client.t.Fatalf("web index does not reference a hashed script: %s", response.Body.String())
	}
	request = httptest.NewRequest(http.MethodGet, string(match[1]), nil)
	request.Header.Set("Accept", "*/*")
	asset := httptest.NewRecorder()
	client.handler.ServeHTTP(asset, request)
	if asset.Code != http.StatusOK || asset.Header().Get("Content-Type") == "" || asset.Body.Len() < 1000 {
		client.t.Fatalf("web asset=%d bytes=%d", asset.Code, asset.Body.Len())
	}
	if asset.Header().Get("Cache-Control") != "public, max-age=31536000, immutable" {
		client.t.Fatalf("web asset cache=%q", asset.Header().Get("Cache-Control"))
	}
	request = httptest.NewRequest(http.MethodGet, "/assets/app.js", nil)
	request.Header.Set("Accept", "*/*")
	legacy := httptest.NewRecorder()
	client.handler.ServeHTTP(legacy, request)
	if legacy.Code != http.StatusNotFound {
		client.t.Fatalf("legacy unhashed asset=%d %s", legacy.Code, legacy.Body.String())
	}
	for _, accept := range []string{"", "*/*", "text/html", "application/json"} {
		request = httptest.NewRequest(http.MethodGet, "/api/not-real", nil)
		if accept != "" {
			request.Header.Set("Accept", accept)
		}
		unknown := httptest.NewRecorder()
		client.handler.ServeHTTP(unknown, request)
		if unknown.Code != http.StatusNotFound || bytes.Contains(unknown.Body.Bytes(), []byte(`<div id="root"></div>`)) {
			client.t.Fatalf("unknown API Accept=%q: status=%d body=%q", accept, unknown.Code, unknown.Body.String())
		}
	}
}

func (client *profileClient) login(username, password string) {
	response := client.request(http.MethodPost, "/api/auth/login", map[string]any{"username": username, "password": password}, false)
	if response.Code != http.StatusOK {
		client.t.Fatalf("login=%d %s", response.Code, response.Body.String())
	}
	var result struct { CSRF string `json:"csrf_token"` }
	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
		client.t.Fatal(err)
	}
	cookies := response.Result().Cookies()
	if len(cookies) != 1 || result.CSRF == "" {
		client.t.Fatalf("login cookie=%#v response=%s", cookies, response.Body.String())
	}
	client.cookie, client.csrf = cookies[0], result.CSRF
}

func (client *profileClient) expectAuthenticationRequired(path string) {
	response := client.request(http.MethodGet, path, nil, false)
	if response.Code != http.StatusUnauthorized {
		client.t.Fatalf("unauthenticated %s=%d %s", path, response.Code, response.Body.String())
	}
}

func (client *profileClient) expectAdminContext(modules []expectedAdminDescriptor, grants []string) {
	response := client.request(http.MethodGet, "/api/admin/context", nil, false)
	if response.Code != http.StatusOK {
		client.t.Fatalf("Admin context=%d %s", response.Code, response.Body.String())
	}
	var result struct {
		Modules []expectedAdminDescriptor `json:"modules"`
		Grants []string `json:"grants"`
	}
	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil { client.t.Fatal(err) }
	if !reflect.DeepEqual(result.Modules, modules) || !reflect.DeepEqual(result.Grants, grants) {
		client.t.Fatalf("Admin context modules=%#v grants=%v", result.Modules, result.Grants)
	}
}

func (client *profileClient) expectEmptyPage(path, field string) {
	response := client.request(http.MethodGet, path, nil, false)
	if response.Code != http.StatusOK {
		client.t.Fatalf("operational page %s=%d %s", path, response.Code, response.Body.String())
	}
	var value map[string]json.RawMessage
	if err := json.Unmarshal(response.Body.Bytes(), &value); err != nil { client.t.Fatal(err) }
	if string(value[field]) != "[]" { client.t.Fatalf("operational page %s field %s=%s", path, field, value[field]) }
}

func (client *profileClient) expectStatus(path string, status int) {
	response := client.request(http.MethodGet, path, nil, false)
	if response.Code != status {
		client.t.Fatalf("GET %s=%d want=%d %s", path, response.Code, status, response.Body.String())
	}
}

func (client *profileClient) create(title, status string) profileRecord {
	response := client.request(http.MethodPost, "/api/records", map[string]any{"title": title, "status": status}, true)
	if response.Code != http.StatusCreated {
		client.t.Fatalf("create=%d %s", response.Code, response.Body.String())
	}
	var record profileRecord
	if err := json.Unmarshal(response.Body.Bytes(), &record); err != nil {
		client.t.Fatal(err)
	}
	return record
}

func (client *profileClient) expectCSRFDenied() {
	csrf := client.csrf
	client.csrf = "incorrect-token"
	response := client.request(http.MethodPost, "/api/records", map[string]any{"title": "Denied", "status": "draft"}, true)
	client.csrf = csrf
	if response.Code != http.StatusForbidden {
		client.t.Fatalf("CSRF denial=%d %s", response.Code, response.Body.String())
	}
}

func (client *profileClient) update(id, title, status string, version int64) profileRecord {
	response := client.request(http.MethodPatch, "/api/records/"+id, map[string]any{"title": title, "status": status, "version": version}, true)
	if response.Code != http.StatusOK {
		client.t.Fatalf("update=%d %s", response.Code, response.Body.String())
	}
	var record profileRecord
	if err := json.Unmarshal(response.Body.Bytes(), &record); err != nil {
		client.t.Fatal(err)
	}
	return record
}

func (client *profileClient) remove(id string) {
	response := client.request(http.MethodDelete, "/api/records/"+id, map[string]any{}, true)
	if response.Code != http.StatusNoContent {
		client.t.Fatalf("delete=%d %s", response.Code, response.Body.String())
	}
}

func (client *profileClient) expectList(id, title string) {
	response := client.request(http.MethodGet, "/api/records", nil, false)
	if response.Code != http.StatusOK {
		client.t.Fatalf("list=%d %s", response.Code, response.Body.String())
	}
	var result struct { Records []profileRecord `json:"records"` }
	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
		client.t.Fatal(err)
	}
	if len(result.Records) != 1 || result.Records[0].ID != id || result.Records[0].Title != title {
		client.t.Fatalf("records=%#v", result.Records)
	}
}

func (client *profileClient) expectEmpty() {
	response := client.request(http.MethodGet, "/api/records", nil, false)
	var result struct { Records []profileRecord `json:"records"` }
	if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &result) != nil || len(result.Records) != 0 {
		client.t.Fatalf("empty list=%d %s", response.Code, response.Body.String())
	}
}

func (client *profileClient) request(method, path string, body any, csrf bool) *httptest.ResponseRecorder {
	client.t.Helper()
	var payload []byte
	if body != nil {
		payload, _ = json.Marshal(body)
	}
	request := httptest.NewRequest(method, path, bytes.NewReader(payload))
	request.Header.Set("Accept", "application/json")
	if body != nil {
		request.Header.Set("Content-Type", "application/json")
	}
	if client.cookie != nil {
		request.AddCookie(client.cookie)
	}
	if csrf {
		request.Header.Set("X-CSRF-Token", client.csrf)
	}
	response := httptest.NewRecorder()
	client.handler.ServeHTTP(response, request)
	return response
}
