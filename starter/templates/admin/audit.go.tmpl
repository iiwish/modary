// Package auditlog contributes scope-bound audit operations to Admin.
package auditlog

import (
	"context"
	"net/http"

	"{{.ModulePath}}/internal/adminapi"
	"github.com/iiwish/modary/appkit"
	"github.com/iiwish/modary/audit"
	"github.com/iiwish/modary/httpkit"
	"github.com/iiwish/modary/module"
	"github.com/iiwish/modary/scope"
	"github.com/iiwish/modary/transport/sessionhttp"
)

const permissionRead = "audit.read"

func Contribution(insecureCookie bool, executionScope scope.Execution) httpkit.Contribution {
	return httpkit.Contribution{
		ID: "audit",
		Requires: []module.Capability{
			module.CapabilityAuditInspection, module.CapabilitySessions, module.CapabilityAuthorization,
		},
		Routes: []httpkit.RouteSpec{ {Method: http.MethodGet, Path: "/api/audit"} },
		Admin: &httpkit.AdminDescriptor{
			Label: "审计日志", Path: "/audit", Icon: "history", Order: 300,
			Permissions: []string{permissionRead}, RequiredPermissions: []string{permissionRead},
		},
		Build: func(_ context.Context, application *appkit.Application) ([]httpkit.Route, error) {
			reader, err := application.AuditReader()
			if err != nil { return nil, err }
			authorizer, err := application.Authorizer()
			if err != nil { return nil, err }
			sessions, err := sessionhttp.New(application, sessionhttp.Options{AllowInsecureCookie: insecureCookie})
			if err != nil { return nil, err }
			handler, err := sessions.Authenticate(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
				_, err := adminapi.Authorize(request.Context(), authorizer, executionScope, permissionRead)
				if err != nil { adminapi.WriteAuthorizationError(writer, request, err); return }
				limit, before, err := adminapi.ListCursor(request.URL.Query(), audit.MaxListLimit)
				if err != nil { adminapi.WriteError(writer, request, http.StatusBadRequest, "INVALID_QUERY", err.Error()); return }
				page, err := reader.List(request.Context(), audit.ListOptions{Scope: executionScope, Limit: limit, BeforeID: before})
				if err != nil { adminapi.WriteError(writer, request, http.StatusInternalServerError, "AUDIT_UNAVAILABLE", "Audit metadata could not be loaded"); return }
				adminapi.WriteJSON(writer, http.StatusOK, page)
			}))
			if err != nil { return nil, err }
			return []httpkit.Route{ {Method: http.MethodGet, Path: "/api/audit", Handler: handler} }, nil
		},
	}
}
