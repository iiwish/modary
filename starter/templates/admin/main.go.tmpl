package main

import (
	"context"
	"fmt"
	"log/slog"
	"os"
	"os/signal"
	"syscall"

	"github.com/iiwish/modary/processkit"
	"{{.ModulePath}}/internal/app"
	"{{.ModulePath}}/internal/config"
)

var (
	version  = "dev"
	revision = "unknown"
	created  = "unknown"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	logger := slog.New(slog.NewJSONHandler(os.Stderr, nil))
	if err := run(ctx, os.Args[1:], logger); err != nil {
		logger.Error("process failed", "event", "process.failed")
		os.Exit(1)
	}
}

func run(ctx context.Context, args []string, logger *slog.Logger) error {
	build, err := processkit.NormalizeBuildInfo(processkit.BuildInfo{Version: version, Revision: revision, Created: created})
	if err != nil {
		return err
	}
	logger.InfoContext(ctx, "process started", "event", "process.started", "build", build)
	mode := "serve"
	if len(args) > 0 {
		mode = args[0]
	}
	if len(args) > 1 {
		return fmt.Errorf("usage: {{.ID}} [serve|migrate]")
	}
	if mode == "migrate" {
		databaseConfig, err := config.LoadDatabase()
		if err != nil {
			return err
		}
		logger.InfoContext(ctx, "database migration started", "event", "database.migration.started")
		if err := app.Migrate(ctx, databaseConfig); err != nil {
			return err
		}
		logger.InfoContext(ctx, "database migration completed", "event", "database.migration.completed")
		return nil
	}
	if mode != "serve" {
		return fmt.Errorf("usage: {{.ID}} [serve|migrate]")
	}
	runtimeConfig, err := config.Load()
	if err != nil {
		return err
	}
	application, err := app.Start(ctx, runtimeConfig)
	if err != nil {
		return fmt.Errorf("start application: %w", err)
	}
	return processkit.Serve(ctx, processkit.ServerOptions{
		Address: runtimeConfig.HTTPAddress, Handler: application.Handler(), Manager: application.Process(),
		Logger: logger, Shutdown: application.Shutdown,
		Build: build,
	})
}
