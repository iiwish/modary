// Package limits owns the Governed Profile's example high-impact feature.
package limits

import (
	"bytes"
	"context"
	"crypto/sha256"
	"database/sql"
	"embed"
	"encoding/hex"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"io/fs"
	"time"

	"github.com/iiwish/modary/action"
	"github.com/iiwish/modary/audit"
	"github.com/iiwish/modary/authz"
	"github.com/iiwish/modary/database"
	"github.com/iiwish/modary/module"
	"github.com/iiwish/modary/scope"
	"github.com/iiwish/modary/task"
)

const (
	// ModuleID owns this feature's migration and lifecycle identity.
	ModuleID = "limits"
	// ActionID is the required-preview mutation exposed by this feature.
	ActionID = "limits.set"
	// Permission is the exact RBAC grant required by ActionID.
	Permission = ActionID
	// TaskKind identifies the durable event committed with the limit change.
	TaskKind = "limits.changed"
	// ErrorVersionConflict is the public optimistic-concurrency error.
	ErrorVersionConflict = "LIMITS.VERSION_CONFLICT"
)

//go:embed migrations/postgres/*.sql
var migrationFiles embed.FS

type setInput struct {
	Value           int64 `json:"value"`
	ExpectedVersion int64 `json:"expected_version"`
}

type setPlan struct {
	CurrentValue   int64 `json:"current_value"`
	CurrentVersion int64 `json:"current_version"`
	NextValue      int64 `json:"next_value"`
	NextVersion    int64 `json:"next_version"`
}

// State is the durable limit for one execution scope. A zero version means no
// limit row exists yet.
type State struct {
	Value   int64 `json:"value"`
	Version int64 `json:"version"`
}

// ChangeEvent is the durable task payload emitted by a committed Action.
type ChangeEvent struct {
	Scope   scope.Execution `json:"scope"`
	Value   int64           `json:"value"`
	Version int64           `json:"version"`
}

// Module returns a side-effect-free feature registration. The Host owns
// migration and Action-handler construction during startup.
func Module() (module.Registration, error) {
	migrations, err := fs.Sub(migrationFiles, "migrations/postgres")
	if err != nil {
		return module.Registration{}, fmt.Errorf("prepare limits migrations: %w", err)
	}
	return module.Registration{
		Definition: module.Definition{
			Manifest: module.Manifest{
				SchemaVersion: module.SchemaVersion,
				ID:            ModuleID,
				Version:       "0.1.0",
				Type:          module.ModuleTypeFeature,
				Requires:      []module.Capability{module.CapabilityDatabase, module.CapabilityTasks},
			},
			Migrations: []module.MigrationSource{
				{Driver: "postgres", Files: migrations},
			},
			Actions: []module.ActionBinding{
				{
				Descriptor: descriptor(),
				NewHandler: func(_ context.Context, services module.Resolver) (action.Handler, error) {
					databaseAccess, err := module.Resolve(services, module.ActionDatabase())
					if err != nil {
						return nil, fmt.Errorf("resolve governed database: %w", err)
					}
					tasks, err := module.Resolve(services, module.Tasks())
					if err != nil {
						return nil, fmt.Errorf("resolve durable tasks: %w", err)
					}
					return &setHandler{database: databaseAccess, tasks: tasks}, nil
				},
				},
			},
		},
	}, nil
}

func descriptor() action.Descriptor {
	integer := func(description string, options ...action.SchemaOption) action.Schema {
		return action.Integer(append([]action.SchemaOption{action.Description(description)}, options...)...)
	}
	return action.Descriptor{
		ID:          ActionID,
		Version:     "1.0.0",
		Title:       "Set workspace limit",
		Description: "Changes one governed workspace limit with optimistic concurrency.",
		InputSchema: action.Object(map[string]action.Field{
			"value": action.RequiredField(integer("New limit value.", action.Minimum(0), action.Maximum(1_000_000))),
			"expected_version": action.RequiredField(integer(
				"Current optimistic version; zero creates the limit.", action.Minimum(0),
			)),
		}).JSON(),
		PreviewSchema: action.Object(map[string]action.Field{
			"current_value":   action.RequiredField(integer("Value observed by Preview.")),
			"current_version": action.RequiredField(integer("Version observed by Preview.", action.Minimum(0))),
			"next_value":      action.RequiredField(integer("Value after execution.")),
			"next_version":    action.RequiredField(integer("Version after execution.", action.Minimum(1))),
		}).JSON(),
		OutputSchema: action.Object(map[string]action.Field{
			"value":   action.RequiredField(integer("Committed limit value.")),
			"version": action.RequiredField(integer("Committed optimistic version.", action.Minimum(1))),
		}).JSON(),
		Permission:          Permission,
		Preview:             action.PreviewRequired,
		AuditLevel:          action.AuditDetailed,
		Channels:            []action.Channel{action.ChannelCLI, action.ChannelHTTP, action.ChannelMCP},
		Errors: []action.ErrorSpec{
			{Code: ErrorVersionConflict, Kind: action.ErrorKindConflict},
		},
		RequiresIdempotency: true,
	}
}

type setHandler struct {
	database database.Access
	tasks    task.Service
}

func (handler *setHandler) Plan(ctx context.Context, request action.Request) (action.PlanData, error) {
	var input setInput
	if err := decodeStrictJSON(request.Input, &input); err != nil {
		return action.PlanData{}, action.NewError(action.CodeValidationFailed, "limit input is invalid")
	}
	current, err := readState(ctx, handler.database, request.Scope)
	if err != nil {
		return action.PlanData{}, fmt.Errorf("read limit state: %w", err)
	}
	if input.ExpectedVersion != current.Version {
		return action.PlanData{}, action.NewError(
			ErrorVersionConflict,
			fmt.Sprintf("limit version is %d, expected %d", current.Version, input.ExpectedVersion),
		)
	}
	if input.Value < 0 || input.Value > 1_000_000 {
		return action.PlanData{}, action.NewError(action.CodeLimitExceeded, "limit value is outside the supported range")
	}
	planned := setPlan{
		CurrentValue: current.Value, CurrentVersion: current.Version,
		NextValue: input.Value, NextVersion: current.Version + 1,
	}
	payload, err := json.Marshal(planned)
	if err != nil {
		return action.PlanData{}, fmt.Errorf("encode limit plan: %w", err)
	}
	summary, err := json.Marshal(planned)
	if err != nil {
		return action.PlanData{}, fmt.Errorf("encode limit preview: %w", err)
	}
	return action.PlanData{
		Payload: payload, Summary: summary,
		Impact:       authz.Impact{Rows: 1, Resources: []string{resourceID(request.Scope)}},
		SnapshotHash: snapshotHash(request.Scope, current),
	}, nil
}

func (handler *setHandler) Execute(ctx context.Context, plan action.Plan) (action.Result, error) {
	var payload setPlan
	if err := decodeStrictJSON(plan.Payload, &payload); err != nil {
		return action.Result{}, fmt.Errorf("decode limit plan: %w", err)
	}
	if payload.CurrentVersion < 0 || payload.NextVersion != payload.CurrentVersion+1 ||
		payload.NextValue < 0 || payload.NextValue > 1_000_000 {
		return action.Result{}, action.NewError(action.CodePlanStale, "limit plan payload is inconsistent")
	}
	current, err := readState(ctx, handler.database, plan.Scope)
	if err != nil {
		return action.Result{}, fmt.Errorf("recheck limit state: %w", err)
	}
	if current.Value != payload.CurrentValue || current.Version != payload.CurrentVersion ||
		snapshotHash(plan.Scope, current) != plan.SnapshotHash {
		return action.Result{}, action.NewError(action.CodePlanStale, "limit changed after Preview")
	}
	result, err := handler.database.ExecContext(ctx, `
		INSERT INTO governed_limits (scope_kind, scope_id, value, version, updated_at)
		VALUES ($1, $2, $3, $4, $5)
		ON CONFLICT(scope_kind, scope_id) DO UPDATE SET
			value = excluded.value,
			version = excluded.version,
			updated_at = excluded.updated_at
		WHERE governed_limits.value = $6 AND governed_limits.version = $7`,
		plan.Scope.Kind, plan.Scope.ID, payload.NextValue, payload.NextVersion, time.Now().UTC(),
		payload.CurrentValue, payload.CurrentVersion,
	)
	if err != nil {
		return action.Result{}, fmt.Errorf("commit limit change: %w", err)
	}
	affected, err := result.RowsAffected()
	if err != nil {
		return action.Result{}, fmt.Errorf("inspect limit change: %w", err)
	}
	if affected != 1 {
		return action.Result{}, action.NewError(action.CodePlanStale, "limit changed while execution was committed")
	}
	event := ChangeEvent{Scope: plan.Scope, Value: payload.NextValue, Version: payload.NextVersion}
	taskPayload, err := json.Marshal(event)
	if err != nil {
		return action.Result{}, fmt.Errorf("encode limit task: %w", err)
	}
	identity := sha256.Sum256(taskPayload)
	if _, err := handler.tasks.Enqueue(ctx, task.Request{
		Kind: TaskKind, Payload: taskPayload, UniqueKey: "sha256:" + hex.EncodeToString(identity[:]),
	}); err != nil {
		return action.Result{}, fmt.Errorf("enqueue limit task: %w", err)
	}
	output, err := json.Marshal(State{Value: payload.NextValue, Version: payload.NextVersion})
	if err != nil {
		return action.Result{}, fmt.Errorf("encode limit result: %w", err)
	}
	return action.Result{
		Data: output,
		Summary: fmt.Sprintf("Workspace limit changed to %d at version %d", payload.NextValue, payload.NextVersion),
		References: []audit.Reference{
			{Kind: "limit", ID: plan.Scope.String()},
		},
	}, nil
}

func readState(ctx context.Context, access database.Access, executionScope scope.Execution) (State, error) {
	var state State
	err := access.QueryRowContext(ctx, `
		SELECT value, version FROM governed_limits
		WHERE scope_kind = $1 AND scope_id = $2`, executionScope.Kind, executionScope.ID,
	).Scan(&state.Value, &state.Version)
	if errors.Is(err, sql.ErrNoRows) {
		return State{}, nil
	}
	if err != nil {
		return State{}, err
	}
	if state.Version < 1 {
		return State{}, fmt.Errorf("stored limit version %d is invalid", state.Version)
	}
	return state, nil
}

func decodeStrictJSON(data json.RawMessage, target any) error {
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.DisallowUnknownFields()
	if err := decoder.Decode(target); err != nil {
		return err
	}
	if err := decoder.Decode(&struct{}{}); err != io.EOF {
		if err == nil {
			return fmt.Errorf("multiple JSON values are not allowed")
		}
		return err
	}
	return nil
}

func resourceID(executionScope scope.Execution) string {
	return "limit:" + executionScope.String()
}

func snapshotHash(executionScope scope.Execution, state State) string {
	material, err := json.Marshal(struct {
		Scope scope.Execution `json:"scope"`
		State State           `json:"state"`
	}{Scope: executionScope, State: state})
	if err != nil {
		panic(fmt.Sprintf("encode limit snapshot: %v", err))
	}
	hash := sha256.Sum256(material)
	return "sha256:" + hex.EncodeToString(hash[:])
}

var _ action.Handler = (*setHandler)(nil)
