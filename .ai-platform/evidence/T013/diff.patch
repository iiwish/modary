+	assertNoInspectionSideEffects(t, counters)
+
+	definition = fixtureDefinition(counters, false)
+	definition.Modules = nil
+	if _, err := Inspect(definition); err == nil {
+		t.Fatal("Inspect accepted an empty composition")
+	}
+	assertNoInspectionSideEffects(t, counters)
+}
