+output=""
+while [ "$#" -gt 0 ]; do
+  if [ "$1" = "-o" ]; then output="$2"; shift 2; else shift; fi
+done
+printf 'started' > "$MODARY_GO_LOG"
+printf 'partial output' > "$output"
+while :; do :; done
+`)
