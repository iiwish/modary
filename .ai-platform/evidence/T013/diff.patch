@@ -0,0 +1,71 @@
+// Package projecttool provides pure inspection, deterministic generation, and
+// Go-only builds for a consumer-owned Modary application Definition. Its F0
+// public API and versioned generated documents are alpha contracts.
+package projecttool
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+var (
+	// ErrContextRequired reports a nil project-tool context.
+	ErrContextRequired = errors.New("project tool context is required")
+	// ErrUsage reports invalid command syntax or command options.
+	ErrUsage = errors.New("invalid project tool usage")
+	// ErrDrift reports missing or differing generated artifacts.
+	ErrDrift = errors.New("generated artifacts have drift")
+	// ErrCallbackPanic reports a contained consumer callback panic.
+	ErrCallbackPanic = errors.New("project tool callback panic")
+)
+
+type usageError struct{ message string }
+
+func (err *usageError) Error() string { return err.message }
+func (err *usageError) Unwrap() error { return ErrUsage }
+
+func newUsageError(format string, arguments ...any) error {
+	return &usageError{message: fmt.Sprintf(format, arguments...)}
+}
+
+// CallbackPanicError reports a recovered consumer callback panic without
+// exposing the recovered value, which may contain application secrets.
+type CallbackPanicError struct{ Operation string }
+
+func (err *CallbackPanicError) Error() string {
+	return fmt.Sprintf("%s callback panicked", err.Operation)
+}
+
+func (err *CallbackPanicError) Unwrap() error { return ErrCallbackPanic }
+
+// DriftStatus classifies a generated artifact mismatch.
+type DriftStatus string
+
+const (
+	// DriftMissing means the configured artifact does not exist.
+	DriftMissing DriftStatus = "missing"
+	// DriftDifferent means the artifact bytes differ from canonical output.
+	DriftDifferent DriftStatus = "different"
+)
+
+// Drift identifies one generated artifact that is absent or differs from its
+// deterministic expected bytes.
+type Drift struct {
+	Path   string      `json:"path"`
+	Status DriftStatus `json:"status"`
+}
+
+// DriftError is returned by command check mode and Build. Programmatic callers
+// can use Project.Check when drift is expected data rather than an error.
+type DriftError struct{ Items []Drift }
+
+func (err *DriftError) Error() string {
+	parts := make([]string, 0, len(err.Items))
+	for _, item := range err.Items {
+		parts = append(parts, item.Path+" ("+string(item.Status)+")")
+	}
+	return "generated artifact drift: " + strings.Join(parts, ", ")
+}
+
+func (err *DriftError) Unwrap() error { return ErrDrift }
diff --git a/action/typescript.go b/action/typescript.go
new file mode 100644
index 0000000..75d5eb1
--- /dev/null
+++ b/action/typescript.go
@@ -0,0 +1,247 @@
+package action
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+var typescriptIdentifier = regexp.MustCompile(`^[A-Za-z_$][A-Za-z0-9_$]*$`)
+
+// GenerateTypeScriptCatalog derives channel-facing TypeScript contracts from
+// the same schemas registered by the Action Runtime. Exact numeric literals
+// outside JavaScript's safe integer range are rejected rather than rounded.
+func GenerateTypeScriptCatalog(descriptors []Descriptor) ([]byte, error) {
+	items := append([]Descriptor(nil), descriptors...)
+	sort.Slice(items, func(i, j int) bool { return items[i].ID < items[j].ID })
+	var output bytes.Buffer
+	output.WriteString("// Code generated by modary action catalog; DO NOT EDIT.\n\n")
+	output.WriteString("export interface ActionContracts {\n")
+	for _, descriptor := range items {
+		input, err := schemaTypeScript(descriptor.InputSchema)
+		if err != nil {
+			return nil, fmt.Errorf("action %s input schema: %w", descriptor.ID, err)
+		}
+		result, err := schemaTypeScript(descriptor.OutputSchema)
+		if err != nil {
+			return nil, fmt.Errorf("action %s output schema: %w", descriptor.ID, err)
+		}
+		actionID, err := typescriptStringLiteral(descriptor.ID)
+		if err != nil {
+			return nil, fmt.Errorf("action %s id: %w", descriptor.ID, err)
+		}
+		fmt.Fprintf(&output, "  %s: {\n    input: %s;\n", actionID, input)
+		if len(descriptor.PreviewSchema) > 0 {
+			preview, err := schemaTypeScript(descriptor.PreviewSchema)
+			if err != nil {
+				return nil, fmt.Errorf("action %s preview schema: %w", descriptor.ID, err)
+			}
+			fmt.Fprintf(&output, "    preview: %s;\n", preview)
+		}
+		fmt.Fprintf(&output, "    output: %s;\n  };\n", result)
+	}
+	output.WriteString("}\n\n")
+	output.WriteString("export type ActionID = keyof ActionContracts;\n")
+	output.WriteString("export type PreviewActionID = { [ID in ActionID]: ActionContracts[ID] extends { preview: unknown } ? ID : never }[ActionID];\n")
+	output.WriteString("export type ActionInput<ID extends ActionID> = ActionContracts[ID][\"input\"];\n")
+	output.WriteString("export type ActionOutput<ID extends ActionID> = ActionContracts[ID][\"output\"];\n")
+	output.WriteString("export type ActionPreview<ID extends ActionID> = ActionContracts[ID] extends { preview: infer Preview } ? Preview : never;\n")
+	return output.Bytes(), nil
+}
+
+func schemaTypeScript(schema json.RawMessage) (string, error) {
+	node, err := decodeSingleJSON(schema)
+	if err != nil {
+		return "", err
+	}
+	return schemaNodeTypeScript(node)
+}
+
+func schemaNodeTypeScript(value any) (string, error) {
+	node, ok := value.(map[string]any)
+	if !ok {
+		return "unknown", nil
+	}
+	if constant, exists := node["const"]; exists {
+		return typescriptLiteral(constant)
+	}
+	if choices, exists := node["enum"].([]any); exists {
+		parts := make([]string, 0, len(choices))
+		for _, choice := range choices {
+			literal, err := typescriptLiteral(choice)
+			if err != nil {
+				return "", err
+			}
+			parts = append(parts, literal)
+		}
+		return strings.Join(parts, " | "), nil
+	}
+	if choices, exists := node["oneOf"].([]any); exists {
+		parts := make([]string, 0, len(choices))
+		for _, choice := range choices {
+			converted, err := schemaNodeTypeScript(choice)
+			if err != nil {
+				return "", err
+			}
+			parts = append(parts, converted)
+		}
+		return strings.Join(parts, " | "), nil
+	}
+	switch node["type"] {
+	case "string":
+		return "string", nil
+	case "integer", "number":
+		return "number", nil
+	case "boolean":
+		return "boolean", nil
+	case "array":
+		item, err := schemaNodeTypeScript(node["items"])
+		if err != nil {
+			return "", err
+		}
+		if strings.Contains(item, " | ") {
+			item = "(" + item + ")"
+		}
+		return "Array<" + item + ">", nil
+	case "object":
+		properties, _ := node["properties"].(map[string]any)
+		if len(properties) == 0 {
+			return "Record<string, unknown>", nil
+		}
+		required := make(map[string]struct{})
+		if items, ok := node["required"].([]any); ok {
+			for _, item := range items {
+				if name, ok := item.(string); ok {
+					required[name] = struct{}{}
+				}
+			}
+		}
+		names := make([]string, 0, len(properties))
+		for name := range properties {
+			names = append(names, name)
+		}
+		sort.Strings(names)
+		parts := make([]string, 0, len(names))
+		for _, name := range names {
+			converted, err := schemaNodeTypeScript(properties[name])
+			if err != nil {
+				return "", err
+			}
+			propertyName := name
+			if !typescriptIdentifier.MatchString(name) {
+				propertyName, err = typescriptStringLiteral(name)
+				if err != nil {
+					return "", fmt.Errorf("encode property name %q: %w", name, err)
+				}
+			}
+			optional := "?"
+			if _, exists := required[name]; exists {
+				optional = ""
+			}
+			parts = append(parts, propertyName+optional+": "+converted)
+		}
+		return "{ " + strings.Join(parts, "; ") + " }", nil
+	default:
+		return "unknown", nil
+	}
+}
+
+func typescriptLiteral(value any) (string, error) {
+	switch typed := value.(type) {
+	case string:
+		return typescriptStringLiteral(typed)
+	case nil:
+		return "null", nil
+	case json.Number:
+		return typescriptNumberLiteral(typed)
+	default:
+		if err := validateTypeScriptNumbers(typed); err != nil {
+			return "", err
+		}
+		canonical, err := canonicalizeJSONValue(typed)
+		if err != nil {
+			return "", err
+		}
+		data, err := json.Marshal(canonical)
+		if err != nil {
+			return "", err
+		}
+		return string(data), nil
+	}
+}
+
+func typescriptStringLiteral(value string) (string, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return "", fmt.Errorf("encode TypeScript string literal: %w", err)
+	}
+	return string(encoded), nil
+}
+
+func validateTypeScriptNumbers(value any) error {
+	return validateTypeScriptNumbersAt(value, "$")
+}
+
+func validateTypeScriptNumbersAt(value any, location string) error {
+	switch typed := value.(type) {
+	case json.Number:
+		_, err := typescriptNumberLiteral(typed)
+		if err != nil {
+			return fmt.Errorf("%s: %w", location, err)
+		}
+	case map[string]any:
+		keys := make([]string, 0, len(typed))
+		for key := range typed {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		for _, key := range keys {
+			if err := validateTypeScriptNumbersAt(typed[key], jsonPointer(location, key)); err != nil {
+				return err
+			}
+		}
+	case []any:
+		for index, item := range typed {
+			if err := validateTypeScriptNumbersAt(item, fmt.Sprintf("%s/%d", location, index)); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func jsonPointer(base, component string) string {
+	component = strings.ReplaceAll(component, "~", "~0")
+	component = strings.ReplaceAll(component, "/", "~1")
+	return base + "/" + component
+}
+
+func typescriptNumberLiteral(value json.Number) (string, error) {
+	normalized, err := normalizeJSONNumber(value.String())
+	if err != nil {
+		return "", err
+	}
+	rational, ok := new(big.Rat).SetString(normalized)
+	if !ok {
+		return "", fmt.Errorf("JSON number %q is invalid", value)
+	}
+	maximumSafeInteger := new(big.Rat).SetInt64(9_007_199_254_740_991)
+	if new(big.Rat).Abs(rational).Cmp(maximumSafeInteger) > 0 {
+		return "", fmt.Errorf("JSON numeric literal %q is outside JavaScript's safe integer range", value)
+	}
+	parsed, err := strconv.ParseFloat(normalized, 64)
+	if err != nil {
+		return "", fmt.Errorf("JSON numeric literal %q is not a finite JavaScript number", value)
+	}
+	roundTrip := strconv.FormatFloat(parsed, 'g', -1, 64)
+	roundTripRational, ok := new(big.Rat).SetString(roundTrip)
+	if !ok || roundTripRational.Cmp(rational) != 0 {
+		return "", fmt.Errorf("JSON numeric literal %q cannot be represented exactly by a JavaScript number literal", value)
+	}
+	return normalized, nil
+}
