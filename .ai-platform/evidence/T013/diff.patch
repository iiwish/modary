+		if err := Run(context.Background(), args, provider, Options{Root: missingRoot, Stdout: io.Discard, Stderr: io.Discard}); !errors.Is(err, ErrUsage) {
+			t.Fatalf("Run(%v) error = %v, want ErrUsage", args, err)
