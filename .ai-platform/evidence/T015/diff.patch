@@ -0,0 +1,64 @@
+#!/bin/sh
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+cd "$root"
+
+status=0
+active_paths=".gitignore .ai-platform/memory/constitution.md .ai-platform/docs Makefile README.md .github scripts docs go.mod action adapters appcmd appkit audit authz database identity internal module projecttool scope transport testdata"
+
+domain_pattern='rulary|ruleset|rule_set|rulespec|workspace|ws_default|company(_id|_license)?|company_address|registered_address|modary-rulary|MODARY_DEMO_PASSWORD|MODARY_AGENT_TOKEN'
+if rg -n -i --glob '!check-neutrality.sh' "$domain_pattern" $active_paths; then
+	printf '%s\n' 'consumer-domain terms remain in the active framework tree' >&2
+	status=1
+fi
+
+framework_paths=".gitignore .ai-platform/memory/constitution.md .ai-platform/docs Makefile .github scripts docs action adapters appcmd appkit audit authz database identity internal module projecttool scope transport"
+consumer_pattern='example\.com/modary-counter-consumer|counter-console|consumer_counter|counter\.(preview|increment)'
+if rg -n -i "$consumer_pattern" $framework_paths --glob '!check-neutrality.sh' --glob '!**/*_test.go'; then
+	printf '%s\n' 'the conformance consumer leaked into framework production or documentation' >&2
+	status=1
+fi
+
+if rg -n 'github\.com/iiwish/modary/internal/' testdata/external-consumer --glob '*.go'; then
+	printf '%s\n' 'the external consumer imports a private Modary package' >&2
+	status=1
+fi
+
+legacy_import_pattern='github\.com/iiwish/modary/(core|modules|internal/(app|generated|transport|webui))'
+if rg -n "$legacy_import_pattern" $active_paths --glob '!check-neutrality.sh'; then
+	printf '%s\n' 'an active file references a removed application-owned import path' >&2
+	status=1
+fi
+
+for obsolete in cmd core modules web tests internal/app internal/generated internal/transport internal/webui modary.yaml package.json pnpm-lock.yaml pnpm-workspace.yaml Dockerfile.release .dockerignore; do
+	if test -e "$obsolete"; then
+		printf 'obsolete application-owned path remains: %s\n' "$obsolete" >&2
+		status=1
+	fi
+done
+
+persisted_artifacts=$(find . -path './.git' -prune -o -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' -o -name '*.exe' \) -print)
+if test -n "$persisted_artifacts"; then
+	printf 'runtime or binary artifacts remain in the active tree:\n%s\n' "$persisted_artifacts" >&2
+	status=1
+fi
+
+unexpected_executables=$(find . -path './.git' -prune -o -type f -perm -111 ! -path './scripts/*.sh' -print)
+if test -n "$unexpected_executables"; then
+	printf 'unexpected executable artifacts remain in the active tree:\n%s\n' "$unexpected_executables" >&2
+	status=1
+fi
+
+unexpected_internal=$(find internal -mindepth 1 -maxdepth 1 -type d ! -name authority ! -name quality -print)
+if test -n "$unexpected_internal"; then
+	printf 'unexpected private framework tree:\n%s\n' "$unexpected_internal" >&2
+	status=1
+fi
+
+if rg -n '^package main$' action adapters appcmd appkit audit authz database identity internal module projecttool scope transport --glob '*.go'; then
+	printf '%s\n' 'the framework production tree contains an application executable' >&2
+	status=1
+fi
+
+exit "$status"
