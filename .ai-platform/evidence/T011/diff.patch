+func TestCleanupExpiredPlansParticipatesInRuntimeDrain(t *testing.T) {
+	registry := newTestRegistry(t)
+	store := &blockingCleanupPlanStore{
+		MemoryPlanStore: NewMemoryPlanStore(),
+		entered:         make(chan struct{}),
+		release:         make(chan struct{}),
+	}
+	runtime, err := NewRuntime(testAuthority(), registry, RuntimeOptions{
+		Authorizer: testAuthorizer{}, Audit: audit.NopHook{}, Plans: store,
+		Idempotency: NewMemoryIdempotencyStore(), Transactions: NopTransactionManager{},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cleanupResult := make(chan error, 1)
+	go func() {
+		_, cleanupErr := runtime.CleanupExpiredPlans(context.Background())
+		cleanupResult <- cleanupErr
+	}()
+	select {
+	case <-store.entered:
+	case <-time.After(time.Second):
+		t.Fatal("plan cleanup did not enter store")
+	}
+	resetResult := make(chan error, 1)
+	go func() { resetResult <- registry.Reset(context.Background(), testAuthority()) }()
+	select {
+	case err := <-resetResult:
+		t.Fatalf("Reset completed before plan cleanup drained: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(store.release)
+	if err := <-cleanupResult; err != nil {
+		t.Fatalf("CleanupExpiredPlans() error = %v", err)
+	}
+	if err := <-resetResult; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestUnknownActionReleasesRuntimeLease(t *testing.T) {
+	clock := time.Date(2026, 7, 30, 12, 0, 0, 0, time.UTC)
+	registry := newTestRegistry(t)
+	runtime, err := NewRuntime(testAuthority(), registry, RuntimeOptions{
+		Authorizer: testAuthorizer{}, Audit: audit.NopHook{}, Plans: NewMemoryPlanStore(),
+		Idempotency: NewMemoryIdempotencyStore(), Transactions: NopTransactionManager{}, Clock: func() time.Time { return clock },
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	request := testRequest()
+	request.ActionID = "unknown.execute"
+	if _, err := runtime.Execute(context.Background(), request); !IsCode(err, CodeActionNotFound) {
+		t.Fatalf("Execute() error = %v", err)
+	}
+	resetCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := registry.Reset(resetCtx, testAuthority()); err != nil {
+		t.Fatalf("unknown action leaked a runtime lease: %v", err)
+	}
+}
+
+func TestActionAuthorityProtectsConstructionMutationAndReset(t *testing.T) {
+	var invalid authority.Token
+	if registry, err := NewRegistry(invalid); err == nil || registry != nil {
+		t.Fatalf("NewRegistry(invalid) = %#v, %v", registry, err)
+	}
+
+	registry := newTestRegistry(t)
+	if err := registry.Register(invalid, "test", testDescriptor(), &testHandler{}); err == nil {
+		t.Fatal("Register accepted an invalid authority token")
+	}
+	if err := registry.Register(testAuthority(), "test", testDescriptor(), &testHandler{}); err != nil {
+		t.Fatal(err)
+	}
+	if err := registry.Reset(context.Background(), invalid); err == nil {
+		t.Fatal("Reset accepted an invalid authority token")
+	}
+	if _, ok := registry.Resolve(testDescriptor().ID); !ok {
+		t.Fatal("invalid Reset mutated Registry")
+	}
+	options := RuntimeOptions{
+		Authorizer: testAuthorizer{}, Audit: audit.NopHook{}, Plans: NewMemoryPlanStore(),
+		Idempotency: NewMemoryIdempotencyStore(), Transactions: NopTransactionManager{},
+	}
+	runtime, err := NewRuntime(testAuthority(), registry, options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := registry.Reset(context.Background(), testAuthority()); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := registry.Resolve(testDescriptor().ID); ok || len(registry.List()) != 0 {
+		t.Fatal("authorized Reset retained Action bindings")
+	}
+	if _, err := runtime.Preview(context.Background(), testRequest()); !IsCode(err, CodeUnavailable) {
+		t.Fatalf("existing Runtime after Reset error = %v", err)
+	}
+	if runtime, err := NewRuntime(invalid, registry, options); err == nil || runtime != nil {
+		t.Fatalf("NewRuntime(invalid) = %#v, %v", runtime, err)
+	}
+}
