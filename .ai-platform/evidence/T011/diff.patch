+func TestNewRuntimeAndShutdownAreRaceSafeAndLinearizable(t *testing.T) {
+	for iteration := 0; iteration < 100; iteration++ {
+		host := NewHost()
+		if err := host.Register(Register(validManifest("feature", "feature", nil, []string{"feature"}), nil)); err != nil {
+			t.Fatal(err)
+		}
+		if err := host.Start(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+		ready := make(chan struct{})
+		var wait sync.WaitGroup
+		wait.Add(2)
+		var runtime *action.Runtime
+		var runtimeErr, shutdownErr error
+		go func() {
+			defer wait.Done()
+			<-ready
+			runtime, runtimeErr = host.NewRuntime(testRuntimeOptions())
+		}()
+		go func() {
+			defer wait.Done()
+			<-ready
+			shutdownErr = host.Shutdown(context.Background())
+		}()
+		close(ready)
+		wait.Wait()
+		if shutdownErr != nil {
+			t.Fatalf("iteration %d Shutdown() error = %v", iteration, shutdownErr)
+		}
+		if runtimeErr != nil && !errors.Is(runtimeErr, ErrInvalidState) {
+			t.Fatalf("iteration %d NewRuntime() error = %v", iteration, runtimeErr)
+		}
+		if runtimeErr == nil && runtime == nil {
+			t.Fatalf("iteration %d NewRuntime() returned nil Runtime without error", iteration)
+		}
+	}
+}
