new file mode 100644
index 0000000..dad4aa0
--- /dev/null
+++ b/action/errors.go
@@ -0,0 +1,94 @@
+package action
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/iiwish/modary/scope"
+)
+
+var ErrCallbackPanic = errors.New("action callback panic")
+
+type CallbackPanicError struct {
+	Operation string
+	Value     any
+}
+
+func (err *CallbackPanicError) Error() string {
+	return fmt.Sprintf("%s panicked: %v", err.Operation, err.Value)
+}
+
+func (err *CallbackPanicError) Unwrap() error { return ErrCallbackPanic }
+
+const (
+	CodeActionNotFound      = "ACTION_NOT_FOUND"
+	CodeValidationFailed    = "VALIDATION_FAILED"
+	CodeAuthzDenied         = "AUTHZ_DENIED"
+	CodePreconditionFailed  = "PRECONDITION_FAILED"
+	CodePlanRequired        = "PLAN_REQUIRED"
+	CodePlanNotFound        = "PLAN_NOT_FOUND"
+	CodePlanStale           = "PLAN_STALE"
+	CodeLimitExceeded       = "LIMIT_EXCEEDED"
+	CodeIdempotencyRequired = "IDEMPOTENCY_REQUIRED"
+	CodeIdempotencyConflict = "IDEMPOTENCY_CONFLICT"
+	CodeIdempotencyProgress = "IDEMPOTENCY_IN_PROGRESS"
+	CodeUnavailable         = "UNAVAILABLE"
+	CodeInternal            = "INTERNAL_ERROR"
+)
+
+type Error struct {
+	Code               string           `json:"error_code"`
+	Message            string           `json:"human_readable_reason"`
+	ActionID           string           `json:"action_id,omitempty"`
+	RequiredPermission string           `json:"required_permission,omitempty"`
+	ActorID            string           `json:"actor_id,omitempty"`
+	Scope              *scope.Execution `json:"scope,omitempty"`
+	RequestID          string           `json:"request_id,omitempty"`
+	Cause              error            `json:"-"`
+	contextual         bool
+}
+
+func (e *Error) Error() string {
+	if e.contextual && e.Cause != nil {
+		return e.Cause.Error()
+	}
+	if e.Cause != nil {
+		return fmt.Sprintf("%s: %s: %v", e.Code, e.Message, e.Cause)
+	}
+	return fmt.Sprintf("%s: %s", e.Code, e.Message)
+}
+
+func (e *Error) Unwrap() error { return e.Cause }
+
+func NewError(code, message string) *Error {
+	return &Error{Code: code, Message: message}
+}
+
+func ErrorCode(err error) string {
+	var actionErr *Error
+	if errors.As(err, &actionErr) {
+		return actionErr.Code
+	}
+	return CodeInternal
+}
+
+func WithRequest(err error, request Request, permission string) error {
+	var actionErr *Error
+	if !errors.As(err, &actionErr) {
+		actionErr = &Error{Code: CodeInternal, Message: "action execution failed", Cause: err}
+	} else {
+		clone := *actionErr
+		clone.Cause = err
+		clone.contextual = true
+		actionErr = &clone
+	}
+	actionErr.ActionID = request.ActionID
+	actionErr.RequiredPermission = permission
+	actionErr.ActorID = request.Actor.ID
+	if !request.Scope.IsZero() {
+		execution := request.Scope
+		actionErr.Scope = &execution
+	}
+	actionErr.RequestID = request.RequestID
+	return actionErr
+}
diff --git a/action/memory.go b/action/memory.go
new file mode 100644
index 0000000..d1b0bf1
--- /dev/null
+++ b/action/memory.go
@@ -0,0 +1,197 @@
+package action
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"sync"
+	"time"
+)
+
+type MemoryPlanStore struct {
+	mu    sync.RWMutex
+	plans map[string]Plan
+}
+
+func (s *MemoryPlanStore) DeleteExpired(_ context.Context, before time.Time) (int64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	var deleted int64
+	for hash, plan := range s.plans {
+		if !plan.ExpiresAt.After(before) {
+			delete(s.plans, hash)
+			deleted++
+		}
+	}
+	return deleted, nil
+}
+
+func NewMemoryPlanStore() *MemoryPlanStore {
+	return &MemoryPlanStore{plans: make(map[string]Plan)}
+}
+
+func (s *MemoryPlanStore) Save(_ context.Context, plan Plan) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.plans[plan.Hash] = clonePlan(plan)
+	return nil
+}
+
+func (s *MemoryPlanStore) Get(_ context.Context, hash string) (Plan, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	plan, ok := s.plans[hash]
+	if !ok {
+		return Plan{}, fmt.Errorf("plan %s: %w", hash, ErrPlanNotFound)
+	}
+	return clonePlan(plan), nil
+}
+
+type MemoryIdempotencyStore struct {
+	mu      sync.Mutex
+	records map[idempotencyKey]IdempotencyRecord
+}
+
+type idempotencyKey struct {
+	scopeKind string
+	scopeID   string
+	actorID   string
+	actionID  string
+	key       string
+}
+
+func NewMemoryIdempotencyStore() *MemoryIdempotencyStore {
+	return &MemoryIdempotencyStore{records: make(map[idempotencyKey]IdempotencyRecord)}
+}
+
+func (s *MemoryIdempotencyStore) Lookup(_ context.Context, record IdempotencyRecord) (*IdempotencyRecord, error) {
+	if err := validateMemoryIdempotencyRecord(record, ""); err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	existing, ok := s.records[idempotencyMapKey(record)]
+	if !ok {
+		return nil, nil
+	}
+	copy := cloneIdempotencyRecord(existing)
+	return &copy, nil
+}
+
+func (s *MemoryIdempotencyStore) Reserve(_ context.Context, record IdempotencyRecord) (*IdempotencyRecord, error) {
+	if err := validateMemoryIdempotencyRecord(record, IdempotencyRunning); err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := idempotencyMapKey(record)
+	if existing, ok := s.records[key]; ok {
+		copy := cloneIdempotencyRecord(existing)
+		return &copy, nil
+	}
+	s.records[key] = cloneIdempotencyRecord(record)
+	return nil, nil
+}
+
+func (s *MemoryIdempotencyStore) Complete(_ context.Context, record IdempotencyRecord) error {
+	if err := validateMemoryIdempotencyRecord(record, IdempotencyCompleted); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := idempotencyMapKey(record)
+	existing, ok := s.records[key]
+	if !ok || existing.Status != IdempotencyRunning || !sameIdempotencyExecution(existing, record) {
+		return fmt.Errorf("idempotency record has no matching running reservation")
+	}
+	s.records[key] = cloneIdempotencyRecord(record)
+	return nil
+}
+
+func (s *MemoryIdempotencyStore) Abort(_ context.Context, record IdempotencyRecord) error {
+	if err := validateMemoryIdempotencyRecord(record, IdempotencyRunning); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	key := idempotencyMapKey(record)
+	if existing, ok := s.records[key]; ok && existing.Status == IdempotencyRunning && sameIdempotencyExecution(existing, record) {
+		delete(s.records, key)
+	}
+	return nil
+}
+
+func validateMemoryIdempotencyRecord(record IdempotencyRecord, status IdempotencyStatus) error {
+	if status != "" && record.Status != status {
+		return fmt.Errorf("idempotency record must have status %q", status)
+	}
+	if err := record.Scope.Validate(); err != nil {
+		return fmt.Errorf("idempotency record scope: %w", err)
+	}
+	if err := validateDescriptorText("actor id", record.ActorID, true, maxActorIDRunes); err != nil {
+		return fmt.Errorf("idempotency record has invalid %w", err)
+	}
+	if err := validateDescriptorText("actor type", record.ActorType, true, maxActorTypeRunes); err != nil {
+		return fmt.Errorf("idempotency record has invalid %w", err)
+	}
+	if !actionIdentifierPattern.MatchString(record.ActionID) {
+		return fmt.Errorf("idempotency record action id %q must match %s", record.ActionID, actionIdentifierPattern.String())
+	}
+	if err := validateDescriptorText("action version", record.ActionVersion, true, maxActionVersionRunes); err != nil || !validActionVersion(record.ActionVersion) {
+		return fmt.Errorf("idempotency record action version %q is invalid", record.ActionVersion)
+	}
+	if !planHashPattern.MatchString(record.ContractHash) {
+		return fmt.Errorf("idempotency record contract hash must be a lowercase SHA-256 digest")
+	}
+	if err := validateDescriptorText("channel", record.Channel, true, maxChannelRunes); err != nil {
+		return fmt.Errorf("idempotency record has invalid %w", err)
+	}
+	if err := validateDescriptorText("idempotency key", record.Key, true, maxIdempotencyKeyRunes); err != nil {
+		return fmt.Errorf("idempotency record has invalid %w", err)
+	}
+	if !planHashPattern.MatchString(record.InputHash) {
+		return fmt.Errorf("idempotency record input hash must be a lowercase SHA-256 digest")
+	}
+	if record.PlanHash != "" && !planHashPattern.MatchString(record.PlanHash) {
+		return fmt.Errorf("idempotency record plan hash must be a lowercase SHA-256 digest")
+	}
+	if status != "" && record.PlanHash == "" {
+		return fmt.Errorf("idempotency record plan hash is required")
+	}
+	if err := validateImpact(record.Impact); err != nil {
+		return fmt.Errorf("idempotency record impact: %w", err)
+	}
+	return nil
+}
+
+func sameIdempotencyExecution(first, second IdempotencyRecord) bool {
+	return first.Scope == second.Scope &&
+		first.ActorID == second.ActorID &&
+		first.ActorType == second.ActorType &&
+		first.ActionID == second.ActionID &&
+		first.ActionVersion == second.ActionVersion &&
+		first.ContractHash == second.ContractHash &&
+		first.Channel == second.Channel &&
+		first.Key == second.Key &&
+		first.InputHash == second.InputHash &&
+		first.PlanHash == second.PlanHash &&
+		first.Impact.Rows == second.Impact.Rows &&
+		slices.Equal(first.Impact.Resources, second.Impact.Resources) &&
+		first.DecisionFingerprint == second.DecisionFingerprint
+}
+
+func idempotencyMapKey(record IdempotencyRecord) idempotencyKey {
+	return idempotencyKey{
+		scopeKind: record.Scope.Kind,
+		scopeID:   record.Scope.ID,
+		actorID:   record.ActorID,
+		actionID:  record.ActionID,
+		key:       record.Key,
+	}
+}
+
+type NopTransactionManager struct{}
+
+func (NopTransactionManager) WithinTransaction(ctx context.Context, fn func(context.Context) error) error {
+	return fn(ctx)
+}
