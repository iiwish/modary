+++ b/action/memory_test.go
@@ -0,0 +1,156 @@
+package action
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/iiwish/modary/audit"
+	"github.com/iiwish/modary/authz"
+	"github.com/iiwish/modary/scope"
+)
+
+func TestMemoryPlanStoreOwnsSavedAndLoadedValues(t *testing.T) {
+	t.Parallel()
+
+	store := NewMemoryPlanStore()
+	plan := Plan{
+		Hash:    "sha256:plan",
+		Scope:   scope.Must("tenant", "one"),
+		Payload: json.RawMessage(`{"value":1}`),
+		Impact:  authz.Impact{Rows: 1, Resources: []string{"counter/one"}},
+	}
+	if err := store.Save(context.Background(), plan); err != nil {
+		t.Fatal(err)
+	}
+	plan.Payload[0] = '['
+	plan.Impact.Resources[0] = "mutated-input"
+
+	loaded, err := store.Get(context.Background(), "sha256:plan")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(loaded.Payload) != `{"value":1}` || loaded.Impact.Resources[0] != "counter/one" {
+		t.Fatalf("stored plan aliased Save input: %#v", loaded)
+	}
+	loaded.Payload[0] = '['
+	loaded.Impact.Resources[0] = "mutated-output"
+	reloaded, err := store.Get(context.Background(), "sha256:plan")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(reloaded.Payload) != `{"value":1}` || reloaded.Impact.Resources[0] != "counter/one" {
+		t.Fatalf("stored plan aliased Get output: %#v", reloaded)
+	}
+}
+
+func TestMemoryIdempotencyStoreOwnsCompletedAndLoadedValues(t *testing.T) {
+	t.Parallel()
+
+	store := NewMemoryIdempotencyStore()
+	record := memoryIdempotencyRecord()
+	record.Result = Result{Data: json.RawMessage(`{"value":1}`), References: []audit.Reference{{Kind: "counter", ID: "one"}}}
+	record.Status = IdempotencyRunning
+	if existing, err := store.Reserve(context.Background(), record); err != nil || existing != nil {
+		t.Fatalf("Reserve() = %#v, %v", existing, err)
+	}
+	record.Status = IdempotencyCompleted
+	if err := store.Complete(context.Background(), record); err != nil {
+		t.Fatal(err)
+	}
+	record.Result.Data[0] = '['
+	record.Result.References[0].ID = "mutated-input"
+	record.Impact.Resources[0] = "mutated-impact-input"
+
+	loaded, err := store.Lookup(context.Background(), record)
+	if err != nil || loaded == nil {
+		t.Fatalf("Lookup() = %#v, %v", loaded, err)
+	}
+	if string(loaded.Result.Data) != `{"value":1}` || loaded.Result.References[0].ID != "one" || loaded.Impact.Resources[0] != "counter/one" {
+		t.Fatalf("stored record aliased Complete input: %#v", loaded)
+	}
+	loaded.Result.Data[0] = '['
+	loaded.Result.References[0].ID = "mutated-output"
+	loaded.Impact.Resources[0] = "mutated-impact-output"
+	reloaded, err := store.Lookup(context.Background(), record)
+	if err != nil || reloaded == nil {
+		t.Fatalf("second Lookup() = %#v, %v", reloaded, err)
+	}
+	if string(reloaded.Result.Data) != `{"value":1}` || reloaded.Result.References[0].ID != "one" || reloaded.Impact.Resources[0] != "counter/one" {
+		t.Fatalf("stored record aliased Lookup output: %#v", reloaded)
+	}
+}
+
+func TestMemoryIdempotencyStoreEnforcesStateTransitions(t *testing.T) {
+	t.Parallel()
+
+	store := NewMemoryIdempotencyStore()
+	record := memoryIdempotencyRecord()
+	record.Status = IdempotencyCompleted
+	if err := store.Complete(context.Background(), record); err == nil {
+		t.Fatal("Complete accepted a record without a running reservation")
+	}
+	record.Status = IdempotencyRunning
+	if existing, err := store.Reserve(context.Background(), record); err != nil || existing != nil {
+		t.Fatalf("Reserve() = %#v, %v", existing, err)
+	}
+	completed := record
+	completed.Status = IdempotencyCompleted
+	completed.Result = Result{Data: json.RawMessage(`{"ok":true}`)}
+	mismatched := completed
+	mismatched.ContractHash = "sha256:" + strings.Repeat("b", 64)
+	if err := store.Complete(context.Background(), mismatched); err == nil {
+		t.Fatal("Complete accepted a different contract provenance")
+	}
+	if err := store.Complete(context.Background(), completed); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.Abort(context.Background(), record); err != nil {
+		t.Fatal(err)
+	}
+	existing, err := store.Lookup(context.Background(), record)
+	if err != nil || existing == nil || existing.Status != IdempotencyCompleted {
+		t.Fatalf("Abort removed completed record: %#v, %v", existing, err)
+	}
+}
+
+func TestMemoryIdempotencyStoreUsesStructuredCompositeKey(t *testing.T) {
+	t.Parallel()
+
+	store := NewMemoryIdempotencyStore()
+	first := memoryIdempotencyRecord()
+	first.ActorID = "actor-action"
+	first.ActionID = "id.execute"
+	second := memoryIdempotencyRecord()
+	second.ActorID = "actor"
+	second.ActionID = "action-id.execute"
+	second.InputHash = "sha256:" + strings.Repeat("c", 64)
+	if _, err := store.Reserve(context.Background(), first); err != nil {
+		t.Fatal(err)
+	}
+	if existing, err := store.Reserve(context.Background(), second); err != nil || existing != nil {
+		t.Fatalf("second structured key collided: existing=%#v err=%v", existing, err)
+	}
+	if len(store.records) != 2 {
+		t.Fatalf("records = %d, want 2 distinct composite keys", len(store.records))
+	}
+}
+
+func memoryIdempotencyRecord() IdempotencyRecord {
+	return IdempotencyRecord{
+		Scope:               scope.Must("tenant", "one"),
+		ActorID:             "user",
+		ActorType:           "user",
+		ActionID:            "counter.increment",
+		ActionVersion:       "1.0.0",
+		ContractHash:        "sha256:" + strings.Repeat("a", 64),
+		Channel:             "http",
+		Key:                 "once",
+		InputHash:           "sha256:" + strings.Repeat("b", 64),
+		PlanHash:            "sha256:" + strings.Repeat("c", 64),
+		Impact:              authz.Impact{Rows: 1, Resources: []string{"counter/one"}},
+		DecisionFingerprint: "grant:v1",
+		Status:              IdempotencyRunning,
+	}
+}
diff --git a/action/registry.go b/action/registry.go
new file mode 100644
index 0000000..db0816a
--- /dev/null
+++ b/action/registry.go
@@ -0,0 +1,457 @@
+package action
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/iiwish/modary/internal/authority"
+	"golang.org/x/mod/semver"
+)
+
+const (
+	maxDescriptorTitleRunes       = 160
+	maxDescriptorDescriptionRunes = 2048
+	maxDescriptorChannels         = 32
+	maxActionVersionRunes         = 128
+	maxChannelRunes               = 64
+)
+
+var actionIdentifierPattern = regexp.MustCompile(`^[a-z][a-z0-9._/-]{0,126}$`)
+
+type registration struct {
+	Descriptor   Descriptor
+	Handler      Handler
+	ModuleID     string
+	ContractHash string
+	input        *Validator
+	preview      *Validator
+	output       *Validator
+}
+
+type Registry struct {
+	mu       sync.RWMutex
+	actions  map[string]registration
+	active   int
+	revoked  bool
+	drained  chan struct{}
+	lifetime context.Context
+	revoke   context.CancelFunc
+}
+
+func NewRegistry(token authority.Token) (*Registry, error) {
+	if !authority.IsActionRuntime(token) {
+		return nil, fmt.Errorf("action runtime authority is required")
+	}
+	lifetime, revoke := context.WithCancel(context.Background())
+	return &Registry{
+		actions:  make(map[string]registration),
+		drained:  make(chan struct{}),
+		lifetime: lifetime,
+		revoke:   revoke,
+	}, nil
+}
+
+// CatalogEntry is the read-only discovery view of an Action. It intentionally
+// omits the Handler so callers cannot bypass the governed Runtime.
+type CatalogEntry struct {
+	Descriptor   Descriptor `json:"descriptor"`
+	ModuleID     string     `json:"module_id"`
+	ContractHash string     `json:"contract_hash"`
+}
+
+func cloneDescriptor(descriptor Descriptor) Descriptor {
+	clone := descriptor
+	clone.InputSchema = append([]byte(nil), descriptor.InputSchema...)
+	clone.PreviewSchema = append([]byte(nil), descriptor.PreviewSchema...)
+	clone.OutputSchema = append([]byte(nil), descriptor.OutputSchema...)
+	clone.Channels = append([]string(nil), descriptor.Channels...)
+	return clone
+}
+
+type compiledDescriptor struct {
+	input   *Validator
+	preview *Validator
+	output  *Validator
+}
+
+// PreparedDescriptor is an immutable, precompiled Action contract. Its
+// validators are intentionally opaque so a Module Host can validate before
+// startup and later bind a Handler without recompiling schemas.
+type PreparedDescriptor struct {
+	descriptor   Descriptor
+	compiled     compiledDescriptor
+	contractHash string
+}
+
+// PrepareDescriptor validates and compiles an Action contract without creating
+// or invoking a Handler.
+func PrepareDescriptor(descriptor Descriptor) (PreparedDescriptor, error) {
+	descriptor = cloneDescriptor(descriptor)
+	sort.Strings(descriptor.Channels)
+	compiled, err := compileDescriptor(descriptor)
+	if err != nil {
+		return PreparedDescriptor{}, err
+	}
+	contractHash, err := hashDescriptorContract(descriptor)
+	if err != nil {
+		return PreparedDescriptor{}, err
+	}
+	return PreparedDescriptor{descriptor: cloneDescriptor(descriptor), compiled: compiled, contractHash: contractHash}, nil
+}
+
+// Descriptor returns a defensive copy of the prepared static contract.
+func (prepared PreparedDescriptor) Descriptor() Descriptor {
+	return cloneDescriptor(prepared.descriptor)
+}
+
+func (prepared PreparedDescriptor) ContractHash() string { return prepared.contractHash }
+
+// ValidateDescriptor compiles every schema and validates the static Action
+// contract without creating or invoking a Handler.
+func ValidateDescriptor(descriptor Descriptor) error {
+	_, err := PrepareDescriptor(descriptor)
+	return err
+}
+
+func compileDescriptor(descriptor Descriptor) (compiledDescriptor, error) {
+	if !actionIdentifierPattern.MatchString(descriptor.ID) {
+		return compiledDescriptor{}, fmt.Errorf("action id %q must match %s", descriptor.ID, actionIdentifierPattern.String())
+	}
+	if err := validateDescriptorText("version", descriptor.Version, true, maxActionVersionRunes); err != nil {
+		return compiledDescriptor{}, fmt.Errorf("action %s has invalid %w", descriptor.ID, err)
+	}
+	if !validActionVersion(descriptor.Version) {
+		return compiledDescriptor{}, fmt.Errorf("action %s version %q is not valid Semantic Versioning 2.0.0", descriptor.ID, descriptor.Version)
+	}
+	if err := validateDescriptorText("title", descriptor.Title, true, maxDescriptorTitleRunes); err != nil {
+		return compiledDescriptor{}, fmt.Errorf("action %s has invalid %w", descriptor.ID, err)
+	}
+	if err := validateDescriptorText("description", descriptor.Description, false, maxDescriptorDescriptionRunes); err != nil {
+		return compiledDescriptor{}, fmt.Errorf("action %s has invalid %w", descriptor.ID, err)
+	}
+	if !actionIdentifierPattern.MatchString(descriptor.Permission) {
+		return compiledDescriptor{}, fmt.Errorf("action %s permission %q must match %s", descriptor.ID, descriptor.Permission, actionIdentifierPattern.String())
+	}
+	if descriptor.Preview != PreviewNone && descriptor.Preview != PreviewOptional && descriptor.Preview != PreviewRequired {
+		return compiledDescriptor{}, fmt.Errorf("action %s has invalid preview policy %q", descriptor.ID, descriptor.Preview)
+	}
+	if descriptor.AuditLevel != AuditMetadata && descriptor.AuditLevel != AuditDetailed {
+		return compiledDescriptor{}, fmt.Errorf("action %s must declare a valid audit level", descriptor.ID)
+	}
+	input, err := CompileValidator(descriptor.InputSchema)
+	if err != nil {
+		return compiledDescriptor{}, fmt.Errorf("action %s must declare a valid input schema: %w", descriptor.ID, err)
+	}
+	var preview *Validator
+	if descriptor.Preview != PreviewNone {
+		if len(descriptor.PreviewSchema) == 0 {
+			return compiledDescriptor{}, fmt.Errorf("action %s must declare a preview summary schema", descriptor.ID)
+		}
+		preview, err = CompileValidator(descriptor.PreviewSchema)
+		if err != nil {
+			return compiledDescriptor{}, fmt.Errorf("action %s must declare a valid preview summary schema: %w", descriptor.ID, err)
+		}
+	} else if len(descriptor.PreviewSchema) > 0 {
+		return compiledDescriptor{}, fmt.Errorf("action %s declares a preview summary schema with preview policy none", descriptor.ID)
+	}
+	output, err := CompileValidator(descriptor.OutputSchema)
+	if err != nil {
+		return compiledDescriptor{}, fmt.Errorf("action %s must declare a valid output schema: %w", descriptor.ID, err)
+	}
+	if len(descriptor.Channels) == 0 {
+		return compiledDescriptor{}, fmt.Errorf("action %s must declare at least one channel", descriptor.ID)
+	}
+	if len(descriptor.Channels) > maxDescriptorChannels {
+		return compiledDescriptor{}, fmt.Errorf("action %s declares more than %d channels", descriptor.ID, maxDescriptorChannels)
+	}
+	seenChannels := make(map[string]struct{}, len(descriptor.Channels))
+	for _, channel := range descriptor.Channels {
+		if err := validateDescriptorText("channel", channel, true, maxChannelRunes); err != nil {
+			return compiledDescriptor{}, fmt.Errorf("action %s has invalid %w", descriptor.ID, err)
+		}
+		if _, exists := seenChannels[channel]; exists {
+			return compiledDescriptor{}, fmt.Errorf("action %s declares channel %q more than once", descriptor.ID, channel)
+		}
+		seenChannels[channel] = struct{}{}
+	}
+	return compiledDescriptor{input: input, preview: preview, output: output}, nil
+}
+
+func validActionVersion(version string) bool {
+	coreVersion := version
+	if index := strings.IndexAny(coreVersion, "-+"); index >= 0 {
+		coreVersion = coreVersion[:index]
+	}
+	return strings.Count(coreVersion, ".") == 2 && semver.IsValid("v"+version)
+}
+
+func hashDescriptorContract(descriptor Descriptor) (string, error) {
+	canonicalSchema := func(name string, schema json.RawMessage) (json.RawMessage, error) {
+		if len(schema) == 0 {
+			return nil, nil
+		}
+		value, err := decodeSingleJSON(schema)
+		if err != nil {
+			return nil, fmt.Errorf("canonicalize %s schema: %w", name, err)
+		}
+		encoded, err := json.Marshal(value)
+		if err != nil {
+			return nil, fmt.Errorf("canonicalize %s schema: %w", name, err)
+		}
+		return encoded, nil
+	}
+	input, err := canonicalSchema("input", descriptor.InputSchema)
+	if err != nil {
+		return "", err
+	}
+	preview, err := canonicalSchema("preview", descriptor.PreviewSchema)
+	if err != nil {
+		return "", err
+	}
+	output, err := canonicalSchema("output", descriptor.OutputSchema)
+	if err != nil {
+		return "", err
+	}
+	material := struct {
+		ID                  string          `json:"id"`
+		Version             string          `json:"version"`
+		InputSchema         json.RawMessage `json:"input_schema"`
+		PreviewSchema       json.RawMessage `json:"preview_schema,omitempty"`
+		OutputSchema        json.RawMessage `json:"output_schema"`
+		Permission          string          `json:"permission"`
+		Preview             PreviewPolicy   `json:"preview"`
+		AuditLevel          AuditLevel      `json:"audit_level"`
+		Channels            []string        `json:"channels"`
+		RequiresIdempotency bool            `json:"requires_idempotency"`
+	}{
+		ID: descriptor.ID, Version: descriptor.Version, InputSchema: input, PreviewSchema: preview,
+		OutputSchema: output, Permission: descriptor.Permission, Preview: descriptor.Preview,
+		AuditLevel: descriptor.AuditLevel, Channels: descriptor.Channels, RequiresIdempotency: descriptor.RequiresIdempotency,
+	}
+	encoded, err := json.Marshal(material)
+	if err != nil {
+		return "", fmt.Errorf("marshal Action contract: %w", err)
+	}
+	hash := sha256.Sum256(encoded)
+	return "sha256:" + hex.EncodeToString(hash[:]), nil
+}
+
+func validateDescriptorText(field, value string, required bool, maxRunes int) error {
+	if !utf8.ValidString(value) {
+		return fmt.Errorf("%s must be valid UTF-8", field)
+	}
+	if required && value == "" {
+		return fmt.Errorf("%s is required", field)
+	}
+	if strings.TrimSpace(value) != value {
+		return fmt.Errorf("%s cannot contain surrounding whitespace", field)
+	}
+	if utf8.RuneCountInString(value) > maxRunes {
+		return fmt.Errorf("%s cannot exceed %d characters", field, maxRunes)
+	}
+	if strings.ContainsFunc(value, unicode.IsControl) {
+		return fmt.Errorf("%s cannot contain control characters", field)
+	}
+	return nil
+}
+
+func (r *Registry) Register(token authority.Token, moduleID string, descriptor Descriptor, handler Handler) error {
+	if !authority.IsActionRuntime(token) {
+		return fmt.Errorf("action runtime authority is required")
+	}
+	if r == nil {
+		return fmt.Errorf("action registry is required")
+	}
+	prepared, err := PrepareDescriptor(descriptor)
+	if err != nil {
+		return err
+	}
+	return r.BindPrepared(token, moduleID, prepared, handler)
+}
+
+// BindPrepared attaches runtime behavior to a contract that was compiled
+// during pure Module validation.
+func (r *Registry) BindPrepared(token authority.Token, moduleID string, prepared PreparedDescriptor, handler Handler) error {
+	if !authority.IsActionRuntime(token) {
+		return fmt.Errorf("action runtime authority is required")
+	}
+	if r == nil {
+		return fmt.Errorf("action registry is required")
+	}
+	descriptor := prepared.descriptor
+	compiled := prepared.compiled
+	if descriptor.ID == "" || compiled.input == nil || compiled.output == nil || !planHashPattern.MatchString(prepared.contractHash) {
+		return fmt.Errorf("prepared Action descriptor is invalid")
+	}
+	if isNilDependency(handler) {
+		return fmt.Errorf("action %s has no handler", descriptor.ID)
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.revoked {
+		return fmt.Errorf("action registry is revoked")
+	}
+	if existing, ok := r.actions[descriptor.ID]; ok {
+		return fmt.Errorf("action %s is already registered by module %s", descriptor.ID, existing.ModuleID)
+	}
+	r.actions[descriptor.ID] = registration{
+		Descriptor: cloneDescriptor(descriptor), Handler: handler, ModuleID: moduleID, ContractHash: prepared.contractHash,
+		input: compiled.input, preview: compiled.preview, output: compiled.output,
+	}
+	return nil
+}
+
+// Reset revokes new execution, cancels active execution contexts, waits for all
+// acquired contracts to drain, and removes every binding. The Registry remains
+// revoked so already-created Runtime values cannot regain execution access.
+func (r *Registry) Reset(ctx context.Context, token authority.Token) error {
+	if !authority.IsActionRuntime(token) {
+		return fmt.Errorf("action runtime authority is required")
+	}
+	if r == nil {
+		return fmt.Errorf("action registry is required")
+	}
+	if ctx == nil {
+		return fmt.Errorf("reset context is required")
+	}
+	r.mu.Lock()
+	if !r.revoked {
+		r.revoked = true
+		clear(r.actions)
+		r.revoke()
+		if r.active == 0 {
+			close(r.drained)
+		}
+	}
+	drained := r.drained
+	r.mu.Unlock()
+	select {
+	case <-drained:
+		return nil
+	default:
+	}
+	select {
+	case <-drained:
+		return nil
+	case <-ctx.Done():
+		select {
+		case <-drained:
+			return nil
+		default:
+			return fmt.Errorf("drain active Action executions: %w", ctx.Err())
+		}
+	}
+}
+
+func (registered registration) validateInput(value []byte) error {
+	return registered.input.Validate(value)
+}
+
+func (registered registration) validatePreview(value []byte) error {
+	if registered.preview == nil {
+		return nil
+	}
+	return registered.preview.Validate(value)
+}
+
+func (registered registration) validateOutput(value []byte) error {
+	return registered.output.Validate(value)
+}
+
+func (r *Registry) resolve(id string) (registration, bool) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	registered, ok := r.actions[id]
+	return registered, ok
+}
+
+func (r *Registry) acquire(parent context.Context, id string) (registration, context.Context, func(), bool, bool) {
+	r.mu.Lock()
+	if r.revoked {
+		r.mu.Unlock()
+		return registration{}, nil, nil, false, true
+	}
+	registered, ok := r.actions[id]
+	r.active++
+	lifetime := r.lifetime
+	r.mu.Unlock()
+
+	executionCtx, cancel := context.WithCancel(parent)
+	stopLifetime := context.AfterFunc(lifetime, cancel)
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			stopLifetime()
+			cancel()
+			r.mu.Lock()
+			r.active--
+			if r.revoked && r.active == 0 {
+				close(r.drained)
+			}
+			r.mu.Unlock()
+		})
+	}
+	return registered, executionCtx, release, ok, false
+}
+
+func (r *Registry) acquireLease(parent context.Context) (context.Context, func(), bool) {
+	r.mu.Lock()
+	if r.revoked {
+		r.mu.Unlock()
+		return nil, nil, true
+	}
+	r.active++
+	lifetime := r.lifetime
+	r.mu.Unlock()
+
+	executionCtx, cancel := context.WithCancel(parent)
+	stopLifetime := context.AfterFunc(lifetime, cancel)
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			stopLifetime()
+			cancel()
+			r.mu.Lock()
+			r.active--
+			if r.revoked && r.active == 0 {
+				close(r.drained)
+			}
+			r.mu.Unlock()
+		})
+	}
+	return executionCtx, release, false
+}
+
+func (r *Registry) available() bool {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return !r.revoked
+}
+
+func (r *Registry) Resolve(id string) (CatalogEntry, bool) {
+	registered, ok := r.resolve(id)
+	if !ok {
+		return CatalogEntry{}, false
+	}
+	return CatalogEntry{Descriptor: cloneDescriptor(registered.Descriptor), ModuleID: registered.ModuleID, ContractHash: registered.ContractHash}, true
+}
+
+func (r *Registry) List() []CatalogEntry {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	items := make([]CatalogEntry, 0, len(r.actions))
+	for _, item := range r.actions {
+		items = append(items, CatalogEntry{Descriptor: cloneDescriptor(item.Descriptor), ModuleID: item.ModuleID, ContractHash: item.ContractHash})
+	}
+	sort.Slice(items, func(i, j int) bool { return items[i].Descriptor.ID < items[j].Descriptor.ID })
+	return items
+}
diff --git a/action/registry_public_test.go b/action/registry_public_test.go
new file mode 100644
index 0000000..142c212
--- /dev/null
+++ b/action/registry_public_test.go
@@ -0,0 +1,110 @@
+package action_test
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/iiwish/modary/action"
+	"github.com/iiwish/modary/internal/authority"
+)
+
+type inertHandler struct{}
+
+func (inertHandler) Plan(context.Context, action.Request) (action.PlanData, error) {
+	return action.PlanData{}, nil
+}
+
+func (inertHandler) Execute(context.Context, action.Plan) (action.Result, error) {
+	return action.Result{}, nil
+}
+
+func TestCatalogDoesNotExposeHandlers(t *testing.T) {
+	token := authority.ActionRuntime()
+	registry, err := action.NewRegistry(token)
+	if err != nil {
+		t.Fatal(err)
+	}
+	descriptor := action.Descriptor{
+		ID:           "catalog.read",
+		Version:      "0.1.0",
+		Title:        "Catalog read",
+		InputSchema:  action.Object(nil).JSON(),
+		OutputSchema: action.Object(nil).JSON(),
+		Permission:   "catalog.read",
+		Preview:      action.PreviewNone,
+		AuditLevel:   action.AuditMetadata,
+		Channels:     []string{"http"},
+	}
+	if err := registry.Register(token, "catalog", descriptor, inertHandler{}); err != nil {
+		t.Fatal(err)
+	}
+	entry, ok := registry.Resolve(descriptor.ID)
+	if !ok || entry.Descriptor.ID != descriptor.ID || entry.ModuleID != "catalog" || entry.ContractHash == "" {
+		t.Fatalf("catalog entry = %#v, %v", entry, ok)
+	}
+	if _, exposed := reflect.TypeOf(entry).FieldByName("Handler"); exposed {
+		t.Fatal("public catalog exposes an Action handler")
+	}
+	entry.Descriptor.Channels[0] = "forged"
+	reloaded, ok := registry.Resolve(descriptor.ID)
+	if !ok || reloaded.Descriptor.Channels[0] != "http" {
+		t.Fatalf("catalog mutation escaped into Registry: %#v", reloaded)
+	}
+}
+
+func TestPreparedDescriptorOwnsStaticContract(t *testing.T) {
+	descriptor := action.Descriptor{
+		ID:           "prepared.read",
+		Version:      "0.1.0",
+		Title:        "Prepared read",
+		InputSchema:  action.Object(nil).JSON(),
+		OutputSchema: action.Object(nil).JSON(),
+		Permission:   "prepared.read",
+		Preview:      action.PreviewNone,
+		AuditLevel:   action.AuditMetadata,
+		Channels:     []string{"http"},
+	}
+	prepared, err := action.PrepareDescriptor(descriptor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	descriptor.Channels[0] = "forged"
+	first := prepared.Descriptor()
+	first.Channels[0] = "mutated-copy"
+	if got := prepared.Descriptor().Channels[0]; got != "http" {
+		t.Fatalf("prepared descriptor mutated through caller: %q", got)
+	}
+}
+
+func TestContractHashIsCanonicalAndBindsGovernanceSemantics(t *testing.T) {
+	descriptor := action.Descriptor{
+		ID: "prepared.write", Version: "1.0.0", Title: "Prepared write",
+		InputSchema:  json.RawMessage(`{ "type": "object", "additionalProperties": false }`),
+		OutputSchema: json.RawMessage(`{"additionalProperties":false,"type":"object"}`),
+		Permission:   "prepared.write", Preview: action.PreviewNone, AuditLevel: action.AuditDetailed,
+		Channels: []string{"mcp", "http"}, RequiresIdempotency: true,
+	}
+	first, err := action.PrepareDescriptor(descriptor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	descriptor.InputSchema = json.RawMessage(`{"additionalProperties":false,"type":"object"}`)
+	descriptor.Channels = []string{"http", "mcp"}
+	canonical, err := action.PrepareDescriptor(descriptor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.ContractHash() != canonical.ContractHash() {
+		t.Fatalf("equivalent contracts hashed differently: %s != %s", first.ContractHash(), canonical.ContractHash())
+	}
+	descriptor.AuditLevel = action.AuditMetadata
+	changed, err := action.PrepareDescriptor(descriptor)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if changed.ContractHash() == canonical.ContractHash() {
+		t.Fatal("audit governance change did not change the contract hash")
+	}
+}
