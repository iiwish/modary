+type httpTestApplication struct {
+	app      *appkit.Application
+	actor    identity.Actor
+	sessions *testAuthenticator
+	handler  *testActionHandler
+}
+
+func newHTTPTestApplication(t *testing.T, withSessions bool) *httpTestApplication {
+	t.Helper()
+	executionScope := scope.Must("tenant", "http-test")
+	actor := identity.Actor{ID: "user-1", Type: "user", DisplayName: "Test User", Scope: executionScope}
+	sessions := newTestAuthenticator(actor)
+	handler := &testActionHandler{}
+	provides := []string{"database", "authorization", "audit", "example"}
+	if withSessions {
+		provides = append(provides, "identity")
+	}
+	manifest := module.Manifest{
+		SchemaVersion: module.SchemaVersion, ID: "unrelated-module-name", Version: "1.0.0", Type: "feature", Provides: provides,
+	}
+	start := func(_ context.Context, install module.Scope) error {
+		if err := module.Provide(install, module.Transactions(), action.TransactionManager(action.NopTransactionManager{})); err != nil {
+			return err
+		}
+		if err := module.Provide(install, module.PlanStore(), action.PlanStore(action.NewMemoryPlanStore())); err != nil {
+			return err
+		}
+		if err := module.Provide(install, module.IdempotencyStore(), action.IdempotencyStore(action.NewMemoryIdempotencyStore())); err != nil {
+			return err
+		}
+		if err := module.Provide(install, module.Authorizer(), authz.Authorizer(testAuthorizer{})); err != nil {
+			return err
+		}
+		if err := module.Provide(install, module.AuditHook(), audit.Hook(audit.NopHook{})); err != nil {
+			return err
+		}
+		if withSessions {
+			if err := module.Provide(install, module.IdentityResolver(), identity.Resolver(sessions)); err != nil {
+				return err
+			}
+			if err := module.Provide(install, module.IdentityStore(), identity.Authenticator(sessions)); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	bindings := []module.ActionBinding{
+		{Descriptor: testActionDescriptor("example.echo", []string{"http"}, action.PreviewOptional), NewHandler: func(context.Context, module.Scope) (action.Handler, error) { return handler, nil }},
+		{Descriptor: testActionDescriptor("example.agent", []string{"mcp"}, action.PreviewNone), NewHandler: func(context.Context, module.Scope) (action.Handler, error) { return handler, nil }},
+	}
+	registration := module.Register(manifest, start, bindings...)
+	application, err := appkit.Start(context.Background(), appkit.Definition{
+		Metadata: appkit.Metadata{ID: "example", Name: "Example Application", Version: "1.0.0"},
+		Modules:  []module.Registration{registration},
+	}, appkit.Options{})
+	if err != nil {
+		t.Fatalf("appkit.Start() error = %v", err)
+	}
+	t.Cleanup(func() { _ = application.Shutdown(context.Background()) })
+	return &httpTestApplication{app: application, actor: actor, sessions: sessions, handler: handler}
+}
+
+func testActionDescriptor(id string, channels []string, preview action.PreviewPolicy) action.Descriptor {
+	descriptor := action.Descriptor{
+		ID: id, Version: "1.2.3", Title: "Echo", Permission: "example.echo", Preview: preview,
+		AuditLevel: action.AuditMetadata, Channels: channels,
+		InputSchema: action.Object(map[string]action.Field{
+			"message": action.RequiredField(action.String(action.MinLength(1))),
+		}).JSON(),
+		OutputSchema: action.Object(map[string]action.Field{
+			"echo": action.RequiredField(action.String()),
+		}).JSON(),
+	}
+	if preview != action.PreviewNone {
+		descriptor.PreviewSchema = action.Object(map[string]action.Field{
+			"matched_rows": action.RequiredField(action.Integer()),
+		}).JSON()
+	}
+	return descriptor
+}
