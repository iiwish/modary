+	}
+
+	preview := performRequest(handler, http.MethodPost, "/api/actions/example.echo/preview", `{"input":{"message":"hello"}}`, "application/json", "application/json", []*http.Cookie{cookie}, map[string]string{"X-CSRF-Token": csrf}, false)
