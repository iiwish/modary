+	registration := module.Register(module.Manifest{
+		SchemaVersion: module.SchemaVersion, ID: "external-probe", Version: "1.0.0", Type: "feature",
+		Provides: []string{"database", "authorization", "audit", "probe"},
+	}, func(_ context.Context, installation module.Scope) error {
+		if err := module.Provide(installation, module.Transactions(), action.TransactionManager(action.NopTransactionManager{})); err != nil {
+			return err
+		}
+		if err := module.Provide(installation, module.PlanStore(), action.PlanStore(action.NewMemoryPlanStore())); err != nil {
+			return err
+		}
+		if err := module.Provide(installation, module.IdempotencyStore(), action.IdempotencyStore(action.NewMemoryIdempotencyStore())); err != nil {
+			return err
+		}
+		if err := module.Provide(installation, module.Authorizer(), authz.Authorizer(externalAllowAll{})); err != nil {
+			return err
+		}
+		return module.Provide(installation, module.AuditHook(), audit.Hook(audit.NopHook{}))
+	}, module.ActionBinding{
+		Descriptor: descriptor,
+		NewHandler: func(context.Context, module.Scope) (action.Handler, error) {
+			return externalProbeHandler{}, nil
+		},
