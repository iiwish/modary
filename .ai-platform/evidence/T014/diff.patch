diff --git a/adapters/sqlaudit/module.go b/adapters/sqlaudit/module.go
new file mode 100644
index 0000000..9672661
--- /dev/null
+++ b/adapters/sqlaudit/module.go
@@ -0,0 +1,67 @@
+// Package sqlaudit provides a neutral SQLite-backed audit Hook.
+//
+// Stability: alpha. Consumers should pin an exact pre-v1 Modary version.
+package sqlaudit
+
+import (
+	"context"
+	"embed"
+	"fmt"
+	"io/fs"
+
+	"github.com/iiwish/modary/audit"
+	"github.com/iiwish/modary/database"
+	"github.com/iiwish/modary/module"
+)
+
+// ModuleID is the stable Module manifest and migration owner identifier.
+const ModuleID = "sql-audit"
+
+//go:embed migrations/sqlite/*.sql
+var migrationFiles embed.FS
+
+var sqliteMigrations = mustMigrationFS()
+
+// Options is reserved for future backward-compatible storage policy. Its zero
+// value is the complete F0 contract and provisions no events.
+type Options struct{}
+
+// Module returns a pure Registration for the SQL Audit Adapter.
+func Module(_ Options) module.Registration {
+	return module.Registration{
+		Definition: module.Definition{
+			Manifest: module.Manifest{
+				SchemaVersion: module.SchemaVersion,
+				ID:            ModuleID,
+				Version:       "0.1.0",
+				Type:          "adapter",
+				Requires:      []string{"database"},
+				Provides:      []string{"audit"},
+			},
+			Migrations: []module.MigrationSource{{Driver: "sqlite", Files: sqliteMigrations}},
+		},
+		Start: start,
+	}
+}
+
+func start(ctx context.Context, installation module.Scope) error {
+	if ctx == nil {
+		return fmt.Errorf("SQL Audit start context is required")
+	}
+	db, err := module.Resolve(installation, module.Database())
+	if err != nil {
+		return fmt.Errorf("resolve database: %w", err)
+	}
+	if err := database.ApplyMigrations(ctx, db, ModuleID, sqliteMigrations); err != nil {
+		return fmt.Errorf("apply SQL Audit migrations: %w", err)
+	}
+	return module.Provide(installation, module.AuditHook(), audit.Hook(&hook{db: db}))
+}
+
+func mustMigrationFS() fs.FS {
+	files, err := fs.Sub(migrationFiles, "migrations/sqlite")
+	if err != nil {
+		panic(err)
+	}
+	return files
+}
diff --git a/database/database.go b/database/database.go
new file mode 100644
index 0000000..a82e7a1
--- /dev/null
+++ b/database/database.go
@@ -0,0 +1,103 @@
+package database
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+)
+
+// Executor is the common subset implemented by sql.DB and sql.Tx that durable
+// services use to participate in a caller-owned transaction when one exists.
+type Executor interface {
+	ExecContext(context.Context, string, ...any) (sql.Result, error)
+	QueryContext(context.Context, string, ...any) (*sql.Rows, error)
+	QueryRowContext(context.Context, string, ...any) *sql.Row
+}
+
+type transactionKey struct{}
+
+type transactionBinding struct {
+	database *sql.DB
+	executor *transactionExecutor
+}
+
+// transactionExecutor deliberately exposes only Executor. In particular, a
+// service receiving it cannot commit or roll back its caller's transaction.
+type transactionExecutor struct{ transaction *sql.Tx }
+
+func (executor *transactionExecutor) ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error) {
+	return executor.transaction.ExecContext(ctx, query, args...)
+}
+
+func (executor *transactionExecutor) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error) {
+	return executor.transaction.QueryContext(ctx, query, args...)
+}
+
+func (executor *transactionExecutor) QueryRowContext(ctx context.Context, query string, args ...any) *sql.Row {
+	return executor.transaction.QueryRowContext(ctx, query, args...)
+}
+
+// WithinTransaction runs operation in a transaction owned by db. A nested call
+// for the same database joins the existing transaction. A nested call for a
+// different database fails rather than silently redirecting SQL to the wrong
+// transaction. Callback errors are preserved and joined with rollback errors.
+// A callback panic is propagated after the transaction is rolled back.
+func WithinTransaction(ctx context.Context, db *sql.DB, operation func(context.Context) error) error {
+	if ctx == nil {
+		return fmt.Errorf("transaction context is required")
+	}
+	if db == nil {
+		return fmt.Errorf("transaction database is required")
+	}
+	if operation == nil {
+		return fmt.Errorf("transaction operation is required")
+	}
+	if existing, present := ctx.Value(transactionKey{}).(*transactionBinding); present {
+		if existing == nil || existing.database == nil || existing.executor == nil || existing.executor.transaction == nil {
+			return fmt.Errorf("transaction context is invalid")
+		}
+		if existing.database != db {
+			return fmt.Errorf("transaction belongs to a different database")
+		}
+		return operation(ctx)
+	}
+
+	transaction, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		return fmt.Errorf("begin transaction: %w", err)
+	}
+	defer transaction.Rollback()
+	txContext := context.WithValue(ctx, transactionKey{}, &transactionBinding{
+		database: db,
+		executor: &transactionExecutor{transaction: transaction},
+	})
+	if err := operation(txContext); err != nil {
+		rollbackErr := transaction.Rollback()
+		if errors.Is(rollbackErr, sql.ErrTxDone) {
+			rollbackErr = nil
+		}
+		return errors.Join(err, rollbackErr)
+	}
+	if err := transaction.Commit(); err != nil {
+		return fmt.Errorf("commit transaction: %w", err)
+	}
+	return nil
+}
+
+// ExecutorFor returns the transaction carried by ctx when it belongs to db, or
+// db when the caller is outside a transaction. Invalid inputs and a transaction
+// owned by another database return nil. The transaction implementation is
+// intentionally opaque and cannot be committed or rolled back by a service.
+func ExecutorFor(ctx context.Context, db *sql.DB) Executor {
+	if ctx == nil || db == nil {
+		return nil
+	}
+	if binding, present := ctx.Value(transactionKey{}).(*transactionBinding); present {
+		if binding == nil || binding.database != db || binding.executor == nil || binding.executor.transaction == nil {
+			return nil
+		}
+		return binding.executor
+	}
+	return db
+}
