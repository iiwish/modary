+func testAuthority() authority.Token {
+	return authority.ActionRuntime()
+}
+
+func newTestRegistry(t *testing.T) *Registry {
+	t.Helper()
+	registry, err := NewRegistry(testAuthority())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return registry
+}
