+
+func TestExecutorForRejectsInvalidInputsAndBindings(t *testing.T) {
+	db := openExecutorTestDB(t)
+	if executor := ExecutorFor(nil, db); executor != nil {
+		t.Fatalf("ExecutorFor(nil, db) = %#v", executor)
+	}
+	if executor := ExecutorFor(context.Background(), nil); executor != nil {
+		t.Fatalf("ExecutorFor(ctx, nil) = %#v", executor)
+	}
+	invalid := context.WithValue(context.Background(), transactionKey{}, (*transactionBinding)(nil))
+	if executor := ExecutorFor(invalid, db); executor != nil {
+		t.Fatalf("ExecutorFor(invalid binding) = %#v", executor)
+	}
+}
+
+func TestWithinTransactionCommitsRollsBackAndHidesControl(t *testing.T) {
+	db := openExecutorTestDB(t)
+	if _, err := db.Exec(`CREATE TABLE item (value INTEGER NOT NULL)`); err != nil {
+		t.Fatal(err)
+	}
+	if err := WithinTransaction(context.Background(), db, func(ctx context.Context) error {
+		executor := ExecutorFor(ctx, db)
+		if executor == nil {
+			t.Fatal("transaction executor is nil")
+		}
+		if _, exposed := executor.(*sql.Tx); exposed {
+			t.Fatal("transaction executor exposes commit and rollback control")
+		}
+		if _, err := executor.ExecContext(ctx, `INSERT INTO item (value) VALUES (1)`); err != nil {
+			return err
+		}
+		return WithinTransaction(ctx, db, func(nested context.Context) error {
+			if ExecutorFor(nested, db) != executor {
+				t.Fatal("nested transaction did not reuse its executor")
+			}
+			_, err := executor.ExecContext(nested, `INSERT INTO item (value) VALUES (2)`)
+			return err
+		})
+	}); err != nil {
+		t.Fatal(err)
+	}
+	assertExecutorCount(t, db, 2)
+
+	want := errors.New("operation failed")
+	if err := WithinTransaction(context.Background(), db, func(ctx context.Context) error {
+		if _, err := ExecutorFor(ctx, db).ExecContext(ctx, `INSERT INTO item (value) VALUES (3)`); err != nil {
+			return err
+		}
+		return want
+	}); !errors.Is(err, want) {
+		t.Fatalf("rollback error = %v", err)
+	}
+	assertExecutorCount(t, db, 2)
+}
+
+func TestTransactionBindingRejectsAnotherDatabase(t *testing.T) {
+	db := openExecutorTestDB(t)
+	other := openExecutorTestDB(t)
+	if err := WithinTransaction(context.Background(), db, func(ctx context.Context) error {
+		if executor := ExecutorFor(ctx, other); executor != nil {
+			t.Fatalf("cross-database ExecutorFor = %#v", executor)
+		}
+		if err := WithinTransaction(ctx, other, func(context.Context) error { return nil }); err == nil {
+			t.Fatal("nested transaction accepted a different database")
+		}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestWithinTransactionRejectsInvalidInputs(t *testing.T) {
+	db := openExecutorTestDB(t)
+	operation := func(context.Context) error { return nil }
+	if err := WithinTransaction(nil, db, operation); err == nil {
+		t.Fatal("WithinTransaction accepted a nil context")
+	}
+	if err := WithinTransaction(context.Background(), nil, operation); err == nil {
+		t.Fatal("WithinTransaction accepted a nil database")
+	}
+	if err := WithinTransaction(context.Background(), db, nil); err == nil {
+		t.Fatal("WithinTransaction accepted a nil operation")
+	}
+}
+
+func openExecutorTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	db, err := sql.Open("sqlite", "file:"+t.Name()+"?mode=memory&cache=shared")
+	if err != nil {
+		t.Fatal(err)
+	}
+	db.SetMaxOpenConns(1)
+	t.Cleanup(func() { _ = db.Close() })
+	return db
+}
+
+func assertExecutorCount(t *testing.T, db *sql.DB, want int) {
+	t.Helper()
+	var got int
+	if err := db.QueryRow(`SELECT COUNT(*) FROM item`).Scan(&got); err != nil {
+		t.Fatal(err)
+	}
+	if got != want {
+		t.Fatalf("item count = %d, want %d", got, want)
+	}
+}
