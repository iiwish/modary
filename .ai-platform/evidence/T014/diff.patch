+func newTestRuntime(t *testing.T, handler Handler, clock *time.Time) (*Runtime, *collectingAudit) {
+	t.Helper()
+	events := &collectingAudit{}
+	return newTestRuntimeWithOptions(t, handler, clock, events, nil), events
+}
+
+func newTestRuntimeWithOptions(t *testing.T, handler Handler, clock *time.Time, hook audit.Hook, plans PlanStore) *Runtime {
+	t.Helper()
+	registry := newTestRegistry(t)
+	err := registry.Register(testAuthority(), "test", testDescriptor(), handler)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if hook == nil {
+		hook = audit.NopHook{}
+	}
+	if plans == nil {
+		plans = NewMemoryPlanStore()
+	}
+	runtime, err := NewRuntime(testAuthority(), registry, RuntimeOptions{
+		Authorizer:   testAuthorizer{},
+		Audit:        hook,
+		Plans:        plans,
+		Idempotency:  NewMemoryIdempotencyStore(),
+		Transactions: NopTransactionManager{},
+		Clock:        func() time.Time { return *clock },
+		PlanTTL:      5 * time.Minute,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return runtime
+}
