+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+
+	"github.com/iiwish/modary/database"
+)
+
+func executorFor(ctx context.Context, db *sql.DB) (database.Executor, error) {
+	if db == nil {
+		return nil, fmt.Errorf("SQLite database is required")
+	}
+	executor := database.ExecutorFor(ctx, db)
+	if executor == nil {
+		return nil, fmt.Errorf("SQLite database executor is unavailable")
+	}
+	return executor, nil
+}
