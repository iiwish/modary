+
+func TestOfficialAdaptersComposeForGovernedWrites(t *testing.T) {
+	ctx := context.Background()
+	databasePath := filepath.Join(t.TempDir(), "conformance.db")
+	executionScope := scope.Must("tenant", "tenant-alpha")
+	actor := identity.Actor{
