+	}
+	close(handler.release)
+	if winnerErr := <-results; winnerErr != nil {
+		t.Fatalf("winning execution error = %v", winnerErr)
+	}
+	if got := handler.executeCalls.Load(); got != 1 {
+		t.Fatalf("Handler Execute() calls = %d, want one", got)
