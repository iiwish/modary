+	if err != nil {
+		t.Fatal(err)
+	}
+	rbacRegistration, err := rbac.Module(rbac.Options{
+		Roles: []rbac.Role{{
+			ID:          "counter-writer",
+			Permissions: []string{conformanceActionID},
+			MaxRows:     maxRows,
