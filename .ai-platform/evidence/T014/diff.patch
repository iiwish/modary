diff --git a/adapters/sqlite/validation.go b/adapters/sqlite/validation.go
new file mode 100644
index 0000000..58b3412
--- /dev/null
+++ b/adapters/sqlite/validation.go
@@ -0,0 +1,304 @@
+package sqlite
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"regexp"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/iiwish/modary/action"
+	"github.com/iiwish/modary/audit"
+	"github.com/iiwish/modary/authz"
+	"golang.org/x/mod/semver"
+)
+
+var (
+	hashPattern = regexp.MustCompile(`^sha256:[0-9a-f]{64}$`)
+)
+
+func normalizePlan(plan action.Plan) (action.Plan, error) {
+	plan.Payload = append(json.RawMessage(nil), plan.Payload...)
+	plan.Impact.Resources = append([]string(nil), plan.Impact.Resources...)
+	plan.CreatedAt = plan.CreatedAt.UTC()
+	plan.ExpiresAt = plan.ExpiresAt.UTC()
+	if !hashPattern.MatchString(plan.Hash) {
+		return action.Plan{}, fmt.Errorf("plan hash must be a lowercase SHA-256 digest")
+	}
+	if err := validateActionID(plan.ActionID); err != nil {
+		return action.Plan{}, err
+	}
+	if err := validateVersion(plan.ActionVersion); err != nil {
+		return action.Plan{}, err
+	}
+	if !hashPattern.MatchString(plan.ContractHash) {
+		return action.Plan{}, fmt.Errorf("contract hash must be a lowercase SHA-256 digest")
+	}
+	if err := validateText("actor id", plan.ActorID, true, audit.MaxActorIDRunes); err != nil {
+		return action.Plan{}, err
+	}
+	if err := validateText("actor type", plan.ActorType, true, audit.MaxActorTypeRunes); err != nil {
+		return action.Plan{}, err
+	}
+	if err := validateText("channel", plan.Channel, true, audit.MaxChannelRunes); err != nil {
+		return action.Plan{}, err
+	}
+	if err := plan.Scope.Validate(); err != nil {
+		return action.Plan{}, err
+	}
+	if !hashPattern.MatchString(plan.InputHash) {
+		return action.Plan{}, fmt.Errorf("input hash must be a lowercase SHA-256 digest")
+	}
+	if err := validateSingleJSON(plan.Payload); err != nil {
+		return action.Plan{}, fmt.Errorf("plan payload: %w", err)
+	}
+	if err := validateImpact(plan.Impact); err != nil {
+		return action.Plan{}, err
+	}
+	if plan.SnapshotHash != "" && !hashPattern.MatchString(plan.SnapshotHash) {
+		return action.Plan{}, fmt.Errorf("snapshot hash must be empty or a lowercase SHA-256 digest")
+	}
+	if err := validateText("decision fingerprint", plan.DecisionFingerprint, false, audit.MaxHashRunes); err != nil {
+		return action.Plan{}, err
+	}
+	if err := validateStoredTime("created at", plan.CreatedAt); err != nil {
+		return action.Plan{}, err
+	}
+	if err := validateStoredTime("expires at", plan.ExpiresAt); err != nil {
+		return action.Plan{}, err
+	}
+	if !plan.ExpiresAt.After(plan.CreatedAt) {
+		return action.Plan{}, fmt.Errorf("plan expiry must be after creation")
+	}
+	return plan, nil
+}
+
+func validateLookupRecord(record action.IdempotencyRecord) error {
+	if err := record.Scope.Validate(); err != nil {
+		return err
+	}
+	if err := validateText("actor id", record.ActorID, true, audit.MaxActorIDRunes); err != nil {
+		return err
+	}
+	if err := validateText("actor type", record.ActorType, true, audit.MaxActorTypeRunes); err != nil {
+		return err
+	}
+	if err := validateActionID(record.ActionID); err != nil {
+		return err
+	}
+	if err := validateVersion(record.ActionVersion); err != nil {
+		return err
+	}
+	if !hashPattern.MatchString(record.ContractHash) {
+		return fmt.Errorf("contract hash must be a lowercase SHA-256 digest")
+	}
+	if err := validateText("channel", record.Channel, true, audit.MaxChannelRunes); err != nil {
+		return err
+	}
+	if err := validateText("idempotency key", record.Key, true, 256); err != nil {
+		return err
+	}
+	if !hashPattern.MatchString(record.InputHash) {
+		return fmt.Errorf("input hash must be a lowercase SHA-256 digest")
+	}
+	if record.PlanHash != "" && !hashPattern.MatchString(record.PlanHash) {
+		return fmt.Errorf("plan hash must be empty or a lowercase SHA-256 digest")
+	}
+	return nil
+}
+
+func normalizeReservation(record action.IdempotencyRecord) (action.IdempotencyRecord, error) {
+	record = cloneIdempotencyRecord(record)
+	if err := validateLookupRecord(record); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if record.PlanHash == "" {
+		return action.IdempotencyRecord{}, fmt.Errorf("idempotency reservation requires a plan hash")
+	}
+	if err := validateImpact(record.Impact); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if err := validateText("decision fingerprint", record.DecisionFingerprint, false, audit.MaxHashRunes); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if record.Status != action.IdempotencyRunning {
+		return action.IdempotencyRecord{}, fmt.Errorf("idempotency reservation must have status %q", action.IdempotencyRunning)
+	}
+	if !resultIsZero(record.Result) {
+		return action.IdempotencyRecord{}, fmt.Errorf("running idempotency record cannot contain a result")
+	}
+	return record, nil
+}
+
+func normalizeCompletion(record action.IdempotencyRecord) (action.IdempotencyRecord, error) {
+	record = cloneIdempotencyRecord(record)
+	if err := validateLookupRecord(record); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if record.PlanHash == "" {
+		return action.IdempotencyRecord{}, fmt.Errorf("completed idempotency record requires a plan hash")
+	}
+	if err := validateImpact(record.Impact); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if err := validateText("decision fingerprint", record.DecisionFingerprint, false, audit.MaxHashRunes); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	if record.Status != action.IdempotencyCompleted {
+		return action.IdempotencyRecord{}, fmt.Errorf("completed idempotency record must have status %q", action.IdempotencyCompleted)
+	}
+	if err := validateResult(record.Result); err != nil {
+		return action.IdempotencyRecord{}, err
+	}
+	return record, nil
+}
+
+func normalizeStoredRecord(record action.IdempotencyRecord) (action.IdempotencyRecord, error) {
+	switch record.Status {
+	case action.IdempotencyRunning:
+		return normalizeReservation(record)
+	case action.IdempotencyCompleted:
+		return normalizeCompletion(record)
+	default:
+		return action.IdempotencyRecord{}, fmt.Errorf("stored idempotency status %q is invalid", record.Status)
+	}
+}
+
+func validateActionID(value string) error {
+	if !action.ValidIdentifier(value) {
+		return fmt.Errorf("action id %q is invalid", value)
+	}
+	return nil
+}
+
+func validateVersion(value string) error {
+	core := value
+	if index := strings.IndexAny(core, "-+"); index >= 0 {
+		core = core[:index]
+	}
+	if len(value) > audit.MaxVersionRunes || strings.Count(core, ".") != 2 || !semver.IsValid("v"+value) {
+		return fmt.Errorf("action version %q is not valid Semantic Versioning 2.0.0", value)
+	}
+	return nil
+}
+
+func validateImpact(impact authz.Impact) error {
+	if impact.Rows < 0 {
+		return fmt.Errorf("impact row count cannot be negative")
+	}
+	if len(impact.Resources) > audit.MaxResources {
+		return fmt.Errorf("impact resource count exceeds %d", audit.MaxResources)
+	}
+	seen := make(map[string]struct{}, len(impact.Resources))
+	for _, resource := range impact.Resources {
+		if err := validateText("impact resource", resource, true, audit.MaxResourceRunes); err != nil {
+			return err
+		}
+		if _, exists := seen[resource]; exists {
+			return fmt.Errorf("impact resource %q is duplicated", resource)
+		}
+		seen[resource] = struct{}{}
+	}
+	return nil
+}
+
+func validateResult(result action.Result) error {
+	if err := validateSingleJSON(result.Data); err != nil {
+		return fmt.Errorf("result data: %w", err)
+	}
+	if err := validateText("result summary", result.Summary, false, audit.MaxSummaryRunes); err != nil {
+		return err
+	}
+	if len(result.References) > audit.MaxReferences {
+		return fmt.Errorf("result reference count exceeds %d", audit.MaxReferences)
+	}
+	seen := make(map[string]struct{}, len(result.References))
+	for _, reference := range result.References {
+		if err := validateText("result reference kind", reference.Kind, true, audit.MaxKindRunes); err != nil {
+			return err
+		}
+		if err := validateText("result reference id", reference.ID, true, audit.MaxIDRunes); err != nil {
+			return err
+		}
+		key := reference.Kind + "\x00" + reference.ID
+		if _, exists := seen[key]; exists {
+			return fmt.Errorf("result reference %s/%s is duplicated", reference.Kind, reference.ID)
+		}
+		seen[key] = struct{}{}
+	}
+	return nil
+}
+
+func resultIsZero(result action.Result) bool {
+	return len(result.Data) == 0 && result.Summary == "" && len(result.References) == 0
+}
+
+func validateText(name, value string, required bool, maxRunes int) error {
+	if !utf8.ValidString(value) {
+		return fmt.Errorf("%s must be valid UTF-8", name)
+	}
+	if required && value == "" {
+		return fmt.Errorf("%s is required", name)
+	}
+	if strings.TrimSpace(value) != value {
+		return fmt.Errorf("%s cannot contain surrounding whitespace", name)
+	}
+	if utf8.RuneCountInString(value) > maxRunes {
+		return fmt.Errorf("%s cannot exceed %d characters", name, maxRunes)
+	}
+	if strings.ContainsFunc(value, unicode.IsControl) {
+		return fmt.Errorf("%s cannot contain control characters", name)
+	}
+	return nil
+}
+
+func validateSingleJSON(data json.RawMessage) error {
+	if len(data) == 0 {
+		return fmt.Errorf("JSON value is required")
+	}
+	if !utf8.Valid(data) {
+		return fmt.Errorf("JSON value must be valid UTF-8")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	var value any
+	if err := decoder.Decode(&value); err != nil {
+		return fmt.Errorf("invalid JSON: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("JSON must contain exactly one value")
+		}
+		return fmt.Errorf("invalid trailing JSON: %w", err)
+	}
+	return nil
+}
+
+func validateStoredTime(name string, value time.Time) error {
+	if value.IsZero() || value.Year() < 1678 || value.Year() > 2261 {
+		return fmt.Errorf("%s is outside the durable SQLite timestamp range", name)
+	}
+	return nil
+}
+
+func parseStoredTime(name, value string) (time.Time, error) {
+	parsed, err := time.Parse(time.RFC3339Nano, value)
+	if err != nil || parsed.Location() != time.UTC || parsed.Format(time.RFC3339Nano) != value {
+		return time.Time{}, fmt.Errorf("stored %s is not canonical UTC RFC3339Nano", name)
+	}
+	if err := validateStoredTime(name, parsed); err != nil {
+		return time.Time{}, err
+	}
+	return parsed, nil
+}
+
+func cloneIdempotencyRecord(record action.IdempotencyRecord) action.IdempotencyRecord {
+	record.Impact.Resources = append([]string(nil), record.Impact.Resources...)
+	record.Result.Data = append(json.RawMessage(nil), record.Result.Data...)
+	record.Result.References = append([]audit.Reference(nil), record.Result.References...)
+	return record
+}
diff --git a/adapters/sqlite/executor.go b/adapters/sqlite/executor.go
