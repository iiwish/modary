      "id": "audit.query",
      "title": "Query audit events",
      "description": "Returns governed action audit events for the current workspace.",
      "input_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "events": {
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "additionalProperties": false
      },
      "permission": "audit.read",
      "preview": "none",
      "audit_level": "metadata",
      "channels": [
        "http",
        "cli"
      ],
      "requires_idempotency": false
    },
