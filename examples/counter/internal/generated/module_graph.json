{
  "schema_version": "modary.module-graph/v1alpha1",
  "application": {
    "id": "counter-console",
    "name": "Counter Console",
    "version": "0.1.0"
  },
  "modules": [
    {
      "id": "counter",
      "version": "0.1.0",
      "type": "feature",
      "requires": [
        "counter.clock",
        "database",
        "tasks"
      ],
      "migrations": [
        "postgres"
      ]
    },
    {
      "id": "local-identity",
      "version": "0.1.0",
      "type": "adapter",
      "requires": [
        "database"
      ],
      "provides": [
        "identity",
        "identity.bearers",
        "identity.passwords",
        "identity.sessions"
      ],
      "migrations": [
        "postgres"
      ]
    },
    {
      "id": "postgres",
      "version": "0.1.0",
      "type": "adapter",
      "provides": [
        "database",
        "tasks",
        "tasks.read"
      ],
      "migrations": [
        "postgres"
      ]
    },
    {
      "id": "rbac",
      "version": "0.1.0",
      "type": "adapter",
      "requires": [
        "database"
      ],
      "provides": [
        "authorization"
      ],
      "migrations": [
        "postgres"
      ]
    },
    {
      "id": "sql-audit",
      "version": "0.1.0",
      "type": "adapter",
      "requires": [
        "database"
      ],
      "provides": [
        "audit",
        "audit.read"
      ],
      "migrations": [
        "postgres"
      ]
    },
    {
      "id": "system-clock",
      "version": "0.1.0",
      "type": "adapter",
      "provides": [
        "counter.clock"
      ]
    }
  ],
  "edges": [
    {
      "from": "counter",
      "to": "postgres",
      "capability": "database"
    },
    {
      "from": "counter",
      "to": "postgres",
      "capability": "tasks"
    },
    {
      "from": "counter",
      "to": "system-clock",
      "capability": "counter.clock"
    },
    {
      "from": "local-identity",
      "to": "postgres",
      "capability": "database"
    },
    {
      "from": "rbac",
      "to": "postgres",
      "capability": "database"
    },
    {
      "from": "sql-audit",
      "to": "postgres",
      "capability": "database"
    }
  ],
  "order": [
    "postgres",
    "system-clock",
    "counter",
    "local-identity",
    "rbac",
    "sql-audit"
  ],
  "provides": {
    "audit": "sql-audit",
    "audit.read": "sql-audit",
    "authorization": "rbac",
    "counter.clock": "system-clock",
    "database": "postgres",
    "identity": "local-identity",
    "identity.bearers": "local-identity",
    "identity.passwords": "local-identity",
    "identity.sessions": "local-identity",
    "tasks": "postgres",
    "tasks.read": "postgres"
  }
}
